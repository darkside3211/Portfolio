		<script is:inline>
			window.addEventListener("DOMContentLoaded", () => {
				// Theme Toggle Script
				const themeToggleBtns =
					document.querySelectorAll(".theme-toggle-btn");

				function updateThemeUI(isLight) {
					themeToggleBtns.forEach((btn) => {
						const textSpan = btn.querySelector("span");
						if (isLight) {
							document.documentElement.classList.add("light");
							btn.innerHTML = textSpan
								? `<span>THEME: BEIGE_MODE</span><span id="theme-icon">☾</span>`
								: "☾";
						} else {
							document.documentElement.classList.remove("light");
							btn.innerHTML = textSpan
								? `<span>THEME: DEFAULT (DARK)</span><span id="theme-icon">☼</span>`
								: "☼";
						}
					});
				}

				// Initialize UI theme state
				const isCurrentlyLight =
					document.documentElement.classList.contains("light");
				updateThemeUI(isCurrentlyLight);

				themeToggleBtns.forEach((btn) => {
					btn.addEventListener("click", () => {
						const isLight =
							document.documentElement.classList.toggle("light");
						localStorage.setItem(
							"theme",
							isLight ? "light" : "dark",
						);
						updateThemeUI(isLight);
					});
				});

				// Mobile Drawer Menu Script
				const menuToggle = document.getElementById("menu-toggle");
				const mobileMenu = document.getElementById("mobile-menu");
				const mobileNavLinks =
					document.querySelectorAll(".mobile-nav-link");

				if (menuToggle && mobileMenu) {
					menuToggle.addEventListener("click", () => {
						const isOpen = menuToggle.classList.toggle("open");
						if (isOpen) {
							mobileMenu.classList.remove(
								"-translate-y-full",
								"opacity-0",
								"pointer-events-none",
							);
						} else {
							mobileMenu.classList.add(
								"-translate-y-full",
								"opacity-0",
								"pointer-events-none",
							);
						}
					});

					mobileNavLinks.forEach((link) => {
						link.addEventListener("click", () => {
							menuToggle.classList.remove("open");
							mobileMenu.classList.add(
								"-translate-y-full",
								"opacity-0",
								"pointer-events-none",
							);
						});
					});
				}
			});
		</script>

		<!-- Rapier 3D + ThreeJS Physics Script -->
		<script>
			import RAPIER from "@dimforge/rapier3d-compat";
			import * as THREE from "three";

			document.addEventListener("DOMContentLoaded", async () => {
				const canvas = document.getElementById("card-physics-canvas");
				if (!canvas) return;

				// Initialize Rapier WebAssembly Engine
				await RAPIER.init();

				const container = canvas.parentElement;
				let width = container.clientWidth || 600;
				let height = container.clientHeight || 300;

				// Scene Setup
				const scene = new THREE.Scene();
				scene.background = new THREE.Color(0x0a0a0c);

				const camera = new THREE.PerspectiveCamera(
					42,
					width / height,
					0.1,
					100,
				);
				camera.position.set(0, 3.8, 5.8);
				camera.lookAt(0, 0, 0);

				const renderer = new THREE.WebGLRenderer({
					canvas,
					antialias: true,
					alpha: true,
				});
				renderer.setSize(width, height);
				renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
				renderer.shadowMap.enabled = true;
				renderer.shadowMap.type = THREE.PCFSoftShadowMap;

				// Lighting Setup
				const ambientLight = new THREE.AmbientLight(0xffffff, 0.85);
				scene.add(ambientLight);

				const dirLight = new THREE.DirectionalLight(0xfff5ea, 1.5);
				dirLight.position.set(4, 8, 5);
				dirLight.castShadow = true;
				dirLight.shadow.mapSize.width = 1024;
				dirLight.shadow.mapSize.height = 1024;
				dirLight.shadow.camera.near = 0.5;
				dirLight.shadow.camera.far = 20;
				dirLight.shadow.camera.left = -5;
				dirLight.shadow.camera.right = 5;
				dirLight.shadow.camera.top = 5;
				dirLight.shadow.camera.bottom = -5;
				dirLight.shadow.bias = -0.0005;
				scene.add(dirLight);

				const fillLight = new THREE.DirectionalLight(0x3b82f6, 0.45);
				fillLight.position.set(-4, 3, -4);
				scene.add(fillLight);

				// Procedural Canvas Texture Generator for Playing Cards
				function createFrontTexture(rank, suit, suitColor, suitSymbol) {
					const cv = document.createElement("canvas");
					cv.width = 512;
					cv.height = 768;
					const ctx = cv.getContext("2d");

					// Base card background
					ctx.fillStyle = "#fcfbf7";
					ctx.fillRect(0, 0, 512, 768);

					// Card inner border lines
					ctx.strokeStyle = "#d9d4c7";
					ctx.lineWidth = 6;
					ctx.strokeRect(16, 16, 480, 736);

					ctx.strokeStyle = "#e8e3d5";
					ctx.lineWidth = 2;
					ctx.strokeRect(24, 24, 464, 720);

					// Corner values & suits
					ctx.fillStyle = suitColor;
					ctx.font = "bold 56px sans-serif";
					ctx.textAlign = "center";

					// Top Left
					ctx.fillText(rank, 54, 76);
					ctx.font = "44px sans-serif";
					ctx.fillText(suitSymbol, 54, 122);

					// Bottom Right (Rotated 180 deg)
					ctx.save();
					ctx.translate(458, 692);
					ctx.rotate(Math.PI);
					ctx.font = "bold 56px sans-serif";
					ctx.fillText(rank, 0, 0);
					ctx.font = "44px sans-serif";
					ctx.fillText(suitSymbol, 0, 46);
					ctx.restore();

					// Center emblem / suit design
					ctx.font = "165px sans-serif";
					ctx.textAlign = "center";
					ctx.textBaseline = "middle";
					ctx.fillText(suitSymbol, 256, 384);

					// Rank watermark label
					ctx.font = "bold 20px monospace";
					ctx.fillStyle = "#78716c";
					ctx.fillText(`${rank} OF ${suit.toUpperCase()}`, 256, 575);

					return new THREE.CanvasTexture(cv);
				}

				function createBackTexture() {
					const cv = document.createElement("canvas");
					cv.width = 512;
					cv.height = 768;
					const ctx = cv.getContext("2d");

					// Dark brutalist back background
					ctx.fillStyle = "#121214";
					ctx.fillRect(0, 0, 512, 768);

					// Golden border accent
					ctx.strokeStyle = "#d97706";
					ctx.lineWidth = 12;
					ctx.strokeRect(20, 20, 472, 728);

					ctx.strokeStyle = "#eab308";
					ctx.lineWidth = 4;
					ctx.strokeRect(32, 32, 448, 704);

					// Geometric grid pattern
					ctx.strokeStyle = "rgba(234, 179, 8, 0.12)";
					ctx.lineWidth = 2;
					for (let i = 40; i < 512; i += 32) {
						ctx.beginPath();
						ctx.moveTo(i, 40);
						ctx.lineTo(i, 728);
						ctx.stroke();
					}
					for (let j = 40; j < 768; j += 32) {
						ctx.beginPath();
						ctx.moveTo(40, j);
						ctx.lineTo(472, j);
						ctx.stroke();
					}

					// Center emblem box
					ctx.fillStyle = "#1c1917";
					ctx.fillRect(116, 264, 280, 240);
					ctx.strokeStyle = "#eab308";
					ctx.lineWidth = 3;
					ctx.strokeRect(116, 264, 280, 240);

					ctx.fillStyle = "#f59e0b";
					ctx.font = "bold 26px monospace";
					ctx.textAlign = "center";
					ctx.fillText("GERARD BALDO", 256, 335);
					ctx.fillStyle = "#d4d4d8";
					ctx.font = "bold 16px monospace";
					ctx.fillText("EXP_01 // SANDBOX", 256, 375);

					ctx.fillStyle = "#10b981";
					ctx.font = "bold 15px monospace";
					ctx.fillText("● RAPIER3D ACTIVE", 256, 435);

					return new THREE.CanvasTexture(cv);
				}

				const cardBackTex = createBackTexture();

				const cardDefs = [
					{ rank: "A", suit: "Spades", color: "#18181b", symbol: "♠" },
					{ rank: "K", suit: "Hearts", color: "#dc2626", symbol: "♥" },
					{ rank: "Q", suit: "Diamonds", color: "#ea580c", symbol: "♦" },
					{ rank: "J", suit: "Clubs", color: "#18181b", symbol: "♣" },
				];

				// Rapier Physics World Initialization
				const gravity = { x: 0.0, y: -9.81, z: 0.0 };
				const world = new RAPIER.World(gravity);

				// Ground Physics & Mesh
				const floorY = -1.25;
				const floorBodyDesc = RAPIER.RigidBodyDesc.fixed().setTranslation(
					0,
					floorY - 0.1,
					0,
				);
				const floorBody = world.createRigidBody(floorBodyDesc);
				const floorColliderDesc = RAPIER.ColliderDesc.cuboid(10.0, 0.1, 10.0)
					.setFriction(0.7)
					.setRestitution(0.2);
				world.createCollider(floorColliderDesc, floorBody);

				// Floor Mesh
				const floorGeo = new THREE.PlaneGeometry(32, 32);
				const floorMat = new THREE.MeshStandardMaterial({
					color: 0x111115,
					roughness: 0.8,
					metalness: 0.2,
				});
				const floorMesh = new THREE.Mesh(floorGeo, floorMat);
				floorMesh.rotation.x = -Math.PI / 2;
				floorMesh.position.y = floorY;
				floorMesh.receiveShadow = true;
				scene.add(floorMesh);

				// Subtle grid helper
				const gridHelper = new THREE.GridHelper(32, 32, 0xeab308, 0x27272a);
				gridHelper.position.y = floorY + 0.001;
				scene.add(gridHelper);

				// Invisible Physics Wall Boundaries
				const createWall = (x, y, z, hx, hy, hz) => {
					const wallDesc = RAPIER.RigidBodyDesc.fixed().setTranslation(
						x,
						y,
						z,
					);
					const wallBody = world.createRigidBody(wallDesc);
					const wallCol = RAPIER.ColliderDesc.cuboid(
						hx,
						hy,
						hz,
					)
						.setFriction(0.4)
						.setRestitution(0.3);
					world.createCollider(wallCol, wallBody);
				};
				createWall(-4.5, 2, 0, 0.1, 5, 8); // Left wall
				createWall(4.5, 2, 0, 0.1, 5, 8); // Right wall
				createWall(0, 2, -4.0, 8, 5, 0.1); // Back wall
				createWall(0, 2, 4.0, 8, 5, 0.1); // Front wall

				// Spawn 4 Dynamic Physics Cards
				const cardObjects = [];
				const edgeMaterial = new THREE.MeshStandardMaterial({
					color: 0xedebe4,
					roughness: 0.8,
				});
				const cardGeo = new THREE.BoxGeometry(1.4, 2.0, 0.02);

				function spawnCards() {
					// Clean up previous card objects if re-spawning
					cardObjects.forEach((item) => {
						scene.remove(item.mesh);
						world.removeRigidBody(item.body);
					});
					cardObjects.length = 0;

					cardDefs.forEach((def, index) => {
						const frontTex = createFrontTexture(
							def.rank,
							def.suit,
							def.color,
							def.symbol,
						);
						const frontMat = new THREE.MeshStandardMaterial({
							map: frontTex,
							roughness: 0.3,
						});
						const backMat = new THREE.MeshStandardMaterial({
							map: cardBackTex,
							roughness: 0.3,
						});

						const materials = [
							edgeMaterial,
							edgeMaterial,
							edgeMaterial,
							edgeMaterial,
							frontMat,
							backMat,
						];
						const mesh = new THREE.Mesh(cardGeo, materials);
						mesh.castShadow = true;
						mesh.receiveShadow = true;
						scene.add(mesh);

						// Stagger spawn coordinates & initial rotational velocity
						const posX = (index - 1.5) * 1.05 + (Math.random() - 0.5) * 0.2;
						const posY = 1.6 + index * 0.55;
						const posZ = (Math.random() - 0.5) * 0.4;

						const q = new THREE.Quaternion();
						q.setFromEuler(
							new THREE.Euler(
								(Math.random() - 0.5) * 0.5,
								(Math.random() - 0.5) * 1.2,
								(Math.random() - 0.5) * 0.6,
							),
						);

						const bodyDesc = RAPIER.RigidBodyDesc.dynamic()
							.setTranslation(posX, posY, posZ)
							.setRotation({ x: q.x, y: q.y, z: q.z, w: q.w })
							.setLinearDamping(0.4)
							.setAngularDamping(0.6);

						const body = world.createRigidBody(bodyDesc);
						const colliderDesc = RAPIER.ColliderDesc.cuboid(
							0.7,
							1.0,
							0.01,
						)
							.setRestitution(0.35)
							.setFriction(0.65)
							.setDensity(1.5);
						world.createCollider(colliderDesc, body);

						body.applyTorqueImpulse(
							{
								x: (Math.random() - 0.5) * 0.04,
								y: (Math.random() - 0.5) * 0.06,
								z: (Math.random() - 0.5) * 0.04,
							},
							true,
						);

						cardObjects.push({ mesh, body, def });
					});
				}

				spawnCards();

				// Bind Reset / Respawn Buttons (Standard + Enlarged HUD)
				const resetBtn = document.getElementById("reset-cards-btn");
				if (resetBtn) {
					resetBtn.addEventListener("click", (e) => {
						e.stopPropagation();
						spawnCards();
					});
				}

				const enlargedRespawnBtn = document.getElementById("enlarged-respawn-btn");
				if (enlargedRespawnBtn) {
					enlargedRespawnBtn.addEventListener("click", (e) => {
						e.stopPropagation();
						spawnCards();
					});
				}

				// Enlarge / Theater Fullscreen Mode Controller
				const cardContainer = document.getElementById("card-canvas-container");
				const enlargeBtn = document.getElementById("enlarge-cards-btn");
				const headerEnlargeBtn = document.getElementById("header-enlarge-btn");
				const closeEnlargeBtn = document.getElementById("close-enlarge-btn");
				const toggleFullscreenBtn = document.getElementById("toggle-fullscreen-btn");

				function setEnlargeMode(enlarge) {
					if (!cardContainer) return;
					const sandboxParent = document.getElementById("sandbox-node-1");
					if (enlarge) {
						cardContainer.classList.add("is-enlarged");
						if (sandboxParent) {
							sandboxParent.classList.add("has-enlarged-child");
						}
						document.body.style.overflow = "hidden";
						if (typeof window.pushTelemetryLogs === "function") {
							window.pushTelemetryLogs([
								{
									type: "OK",
									text: "EXP_01 Canvas Viewport Enlarged: Theater mode active.",
								},
							]);
						}
					} else {
						cardContainer.classList.remove("is-enlarged");
						if (sandboxParent) {
							sandboxParent.classList.remove("has-enlarged-child");
						}
						document.body.style.overflow = "";
						if (document.fullscreenElement) {
							document.exitFullscreen().catch(() => {});
						}
						if (typeof window.pushTelemetryLogs === "function") {
							window.pushTelemetryLogs([
								{
									type: "SYS",
									text: "EXP_01 Canvas Viewport Restored to dashboard layout.",
								},
							]);
						}
					}

					// Update canvas layout dimensions smoothly
					setTimeout(() => {
						const rect = container.getBoundingClientRect();
						const w = Math.floor(rect.width) || 600;
						const h = Math.floor(rect.height) || 300;
						camera.aspect = w / h;
						camera.updateProjectionMatrix();
						renderer.setSize(w, h);
					}, 60);
				}

				if (enlargeBtn) {
					enlargeBtn.addEventListener("click", (e) => {
						e.stopPropagation();
						setEnlargeMode(true);
					});
				}

				if (headerEnlargeBtn) {
					headerEnlargeBtn.addEventListener("click", (e) => {
						e.stopPropagation();
						setEnlargeMode(true);
					});
				}

				if (closeEnlargeBtn) {
					closeEnlargeBtn.addEventListener("click", (e) => {
						e.stopPropagation();
						setEnlargeMode(false);
					});
				}

				if (toggleFullscreenBtn) {
					toggleFullscreenBtn.addEventListener("click", (e) => {
						e.stopPropagation();
						if (!document.fullscreenElement) {
							cardContainer.requestFullscreen().catch(() => {});
						} else {
							document.exitFullscreen().catch(() => {});
						}
					});
				}

				// Global Keyboard Shortcuts (ESC to close, R to respawn cards)
				window.addEventListener("keydown", (e) => {
					if (e.key === "Escape" && cardContainer && cardContainer.classList.contains("is-enlarged")) {
						setEnlargeMode(false);
					} else if ((e.key === "r" || e.key === "R") && !e.target.matches("input, textarea, select")) {
						if (cardContainer && cardContainer.classList.contains("is-enlarged")) {
							spawnCards();
						}
					}
				});

				// Interactive Mouse / Touch Raycasting & Pick Up Logic
				const raycaster = new THREE.Raycaster();
				const mouse = new THREE.Vector2();
				let draggedCard = null;
				const dragPlane = new THREE.Plane();
				const dragIntersection = new THREE.Vector3();
				const planeNormal = new THREE.Vector3(0, 0, 1);
				let prevMousePos = { x: 0, y: 0 };
				let mouseVel = { x: 0, y: 0 };

				function updateMouse(e) {
					const rect = canvas.getBoundingClientRect();
					mouse.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
					mouse.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;

					mouseVel.x = e.clientX - prevMousePos.x;
					mouseVel.y = e.clientY - prevMousePos.y;
					prevMousePos = { x: e.clientX, y: e.clientY };
				}

				canvas.addEventListener("pointermove", (e) => {
					updateMouse(e);
					raycaster.setFromCamera(mouse, camera);

					if (draggedCard) {
						raycaster.ray.intersectPlane(dragPlane, dragIntersection);
						if (dragIntersection) {
							const currPos = draggedCard.body.translation();
							const targetX = dragIntersection.x;
							const targetY = Math.max(
								dragIntersection.y,
								floorY + 0.8,
							);
							const targetZ = dragIntersection.z;

							const vx = (targetX - currPos.x) * 16;
							const vy = (targetY - currPos.y) * 16;
							const vz = (targetZ - currPos.z) * 16;

							draggedCard.body.setLinvel(
								{ x: vx, y: vy, z: vz },
								true,
							);
							draggedCard.body.wakeUp();
						}
						return;
					}

					const cardMeshes = cardObjects.map((c) => c.mesh);
					const intersects = raycaster.intersectObjects(cardMeshes);

					if (intersects.length > 0) {
						canvas.style.cursor = "grab";
					} else {
						canvas.style.cursor = "default";
					}
				});

				canvas.addEventListener("pointerdown", (e) => {
					updateMouse(e);
					raycaster.setFromCamera(mouse, camera);

					const cardMeshes = cardObjects.map((c) => c.mesh);
					const intersects = raycaster.intersectObjects(cardMeshes);

					if (intersects.length > 0) {
						const hitMesh = intersects[0].object;
						draggedCard = cardObjects.find((c) => c.mesh === hitMesh);
						if (draggedCard) {
							canvas.style.cursor = "grabbing";
							const pos = draggedCard.mesh.position;
							planeNormal.copy(camera.position).sub(pos).normalize();
							dragPlane.setFromNormalAndCoplanarPoint(
								planeNormal,
								pos,
							);

							draggedCard.body.wakeUp();
							draggedCard.body.applyImpulse(
								{ x: 0, y: 0.15, z: 0 },
								true,
							);
						}
					}
				});

				const releaseCard = () => {
					if (draggedCard) {
						canvas.style.cursor = "default";
						const tossX = mouseVel.x * 0.015;
						const tossY = -mouseVel.y * 0.015;
						draggedCard.body.applyImpulse(
							{ x: tossX, y: Math.max(tossY, 0), z: 0 },
							true,
						);
						draggedCard.body.applyTorqueImpulse(
							{
								x: (Math.random() - 0.5) * 0.05,
								y: (Math.random() - 0.5) * 0.05,
								z: (Math.random() - 0.5) * 0.05,
							},
							true,
						);
						draggedCard = null;
					}
				};

				canvas.addEventListener("pointerup", releaseCard);
				canvas.addEventListener("pointerleave", releaseCard);

				// Responsive Canvas Resize Observer
				const resizeObserver = new ResizeObserver(() => {
					const rect = container.getBoundingClientRect();
					const w = Math.floor(rect.width) || container.clientWidth || 600;
					const h = Math.floor(rect.height) || container.clientHeight || 300;
					camera.aspect = w / h;
					camera.updateProjectionMatrix();
					renderer.setSize(w, h);
				});
				resizeObserver.observe(container);

				// Animation & Physics Stepping Loop
				function animate() {
					requestAnimationFrame(animate);

					world.step();

					cardObjects.forEach(({ mesh, body }) => {
						const pos = body.translation();
						const rot = body.rotation();
						mesh.position.set(pos.x, pos.y, pos.z);
						mesh.quaternion.set(rot.x, rot.y, rot.z, rot.w);
					});

					renderer.render(scene, camera);
				}

				animate();
			});
		</script>
	</body>
</html>
