---
// src/pages/projects/spatial-map.astro
import "../../styles/global.css";
---

<!doctype html>
<html lang="en" class="scroll-smooth overflow-x-hidden">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Gerard Baldo | Spatial Map Case Study</title>

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;1,400&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;0,6..72,700;1,6..72,400;1,6..72,500&family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap"
			rel="stylesheet"
		/>

		<link
			rel="stylesheet"
			href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
			integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
			crossorigin=""
		/>
		<script
			is:inline
			src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
			integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
			crossorigin=""></script>

		<script is:inline>
			(function () {
				const savedTheme = localStorage.getItem("theme");
				if (savedTheme === "light") {
					document.documentElement.classList.add("light");
				} else {
					document.documentElement.classList.remove("light");
				}
			})();
		</script>

		<style>
			#interactive-simulation-card {
				transition:
					width 0.7s cubic-bezier(0.16, 1, 0.3, 1),
					border-color 0.7s ease,
					box-shadow 0.7s ease,
					background-color 0.25s ease;
				width: 100%;
				max-width: none;
			}
			/* Mobile / Tablet default: width 100%, expand style properties only */
			#interactive-simulation-card.expanded {
				width: 100%;
				border-color: rgba(16, 185, 129, 0.35);
				box-shadow: 0 10px 20px -10px rgba(0, 0, 0, 0.9);
				background-color: rgba(10, 10, 10, 0.45);
				backdrop-filter: blur(12px);
			}
			/* Desktop breakpoint (lg: 1024px) - trigger actual width expansion breakout */
			@media (min-width: 1024px) {
				#interactive-simulation-card.expanded {
					width: calc(100vw - 16rem - 8rem);
					box-shadow:
						0 20px 40px -15px rgba(0, 0, 0, 0.9),
						0 0 35px -5px rgba(16, 185, 129, 0.15);
				}
			}

			/* Beige mode overrides */
			:global(.light) #interactive-simulation-card.expanded {
				background-color: rgba(242, 238, 225, 0.65);
				border-color: rgba(16, 185, 129, 0.4);
				box-shadow: 0 20px 40px -15px rgba(130, 120, 100, 0.12);
			}
			:global(.light) #interactive-simulation-card .bg-neutral-950 {
				background-color: #fdfdfc;
				border-color: #e6e0d2;
			}
			:global(.light) #interactive-simulation-card .bg-neutral-900 {
				background-color: #f3eee0;
				border-color: #ddd7c9;
			}
			:global(.light) #interactive-simulation-card input,
			:global(.light) #interactive-simulation-card select {
				color: #2a2822;
				background-color: #f3eee0;
				border-color: #ddd7c9;
			}
			:global(.light) #interactive-simulation-card .text-neutral-100,
			:global(.light) #interactive-simulation-card .text-neutral-200,
			:global(.light) #interactive-simulation-card .text-neutral-300 {
				color: #2a2822;
			}
			:global(.light) #interactive-simulation-card .text-neutral-400,
			:global(.light) #interactive-simulation-card .text-neutral-500 {
				color: #7d7766;
			}
			:global(.light) #sim-api-console {
				background-color: #f3eee0;
				border-color: #ddd7c9;
				color: #5c574a;
			}
			:global(.light) #sim-payload-json {
				color: #047857;
			}
		</style>
	</head>
	<body
		class="bg-neutral-950 text-neutral-100 font-sans selection:bg-neutral-800 antialiased overflow-x-hidden"
	>
		<div class="flex min-h-screen">
			<!-- Mobile Header -->
			<header
				class="fixed top-0 left-0 right-0 h-16 border-b border-neutral-800 bg-neutral-950/90 backdrop-blur-md px-4 flex items-center justify-between z-50 lg:hidden"
			>
				<div class="flex items-center gap-3">
					<div
						class="h-9 w-9 rounded bg-neutral-900 border border-neutral-800 flex items-center justify-center text-xs font-bold tracking-tight text-neutral-300"
					>
						GB
					</div>
					<div>
						<h2
							class="text-xs font-semibold text-neutral-200 tracking-tight"
						>
							Gerard Baldo
						</h2>
						<p class="text-[9px] text-neutral-500 font-mono">
							System-First Engineer
						</p>
					</div>
				</div>
				<div class="flex items-center gap-2">
					<button
						class="theme-toggle-btn border border-neutral-800 bg-neutral-900/10 text-neutral-400 hover:text-neutral-200 transition-all rounded p-1.5 text-xs font-mono select-none cursor-pointer"
						aria-label="Toggle Theme"
					>
						☼
					</button>
					<button
						id="menu-toggle"
						class="border border-neutral-800 bg-neutral-900/10 text-neutral-400 hover:text-neutral-200 transition-all rounded p-1.5 text-xs font-mono select-none cursor-pointer"
						aria-label="Toggle Menu"
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="18"
							height="18"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
						>
							<line
								x1="4"
								y1="12"
								x2="20"
								y2="12"
								id="menu-line-1"></line>
							<line x1="4" y1="6" x2="20" y2="6" id="menu-line-2"
							></line>
							<line
								x1="4"
								y1="18"
								x2="20"
								y2="18"
								id="menu-line-3"></line>
						</svg>
					</button>
				</div>
			</header>

			<!-- Mobile Navigation Drawer -->
			<div
				id="mobile-menu"
				class="fixed inset-x-0 top-16 bg-neutral-950/95 border-b border-neutral-800 z-40 flex flex-col justify-between p-6 transition-all duration-300 ease-in-out -translate-y-full opacity-0 pointer-events-none lg:hidden"
			>
				<nav class="flex flex-col gap-4 text-sm mt-4">
					<a
						href="/"
						class="mobile-nav-link group flex items-center gap-2 text-neutral-400 hover:text-neutral-100 transition-colors py-1.5 font-medium font-mono text-xs tracking-wider"
					>
						➔ RETURN_HOME
					</a>
				</nav>

				<div
					class="flex flex-col gap-4 mt-8 pt-4 border-t border-neutral-800"
				>
					<div
						class="text-[10px] text-neutral-500 font-mono flex items-center gap-2 tracking-tight"
					>
						<span
							class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"
						></span>
						<span>ENVIRONMENT: ACTIVE</span>
					</div>
				</div>
			</div>

			<aside
				class="hidden lg:flex fixed top-0 left-0 h-screen w-64 border-r border-neutral-800 bg-neutral-950 p-6 flex-col justify-between z-50"
			>
				<div class="flex flex-col gap-8">
					<div class="flex flex-col gap-3">
						<div
							class="h-14 w-14 rounded-lg bg-neutral-900 border border-neutral-800 flex items-center justify-center text-lg font-bold tracking-tight text-neutral-300"
						>
							GB
						</div>
						<div>
							<h2
								class="font-semibold text-neutral-200 tracking-tight"
							>
								Gerard Baldo
							</h2>
							<p class="text-xs text-neutral-500 font-mono">
								System-First Engineer
							</p>
						</div>
					</div>

					<nav class="flex flex-col gap-2 text-sm">
						<a
							href="/"
							class="text-neutral-400 hover:text-neutral-100 transition-colors py-1.5 font-medium font-mono text-xs tracking-wider"
							>➔ RETURN_HOME</a
						>
					</nav>
				</div>

				<div class="flex flex-col gap-4">
					<button
						id="theme-toggle"
						class="theme-toggle-btn flex items-center justify-between w-full border border-neutral-800 hover:border-neutral-700 bg-neutral-900/10 hover:bg-neutral-900/30 text-neutral-400 hover:text-neutral-200 transition-all rounded px-3 py-2 text-xs font-mono select-none cursor-pointer"
					>
						<span>THEME: DEFAULT (DARK)</span>
						<span id="theme-icon">☼</span>
					</button>

					<div
						class="text-[10px] text-neutral-500 font-mono flex items-center gap-2 tracking-tight"
					>
						<span
							class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"
						></span>
						<span>ENVIRONMENT: ACTIVE</span>
					</div>
				</div>
			</aside>

			<main
				class="flex-1 px-4 md:px-8 pt-24 pb-16 lg:ml-64 lg:px-16 lg:py-16 max-w-6xl grid grid-cols-1 lg:grid-cols-12 gap-8 items-start"
			>
				<!-- LEFT COLUMN: Content Column (Spans 8 of 12 columns) -->
				<div class="lg:col-span-8 flex flex-col gap-8">
					<a
						href="/"
						class="text-xs font-mono text-neutral-500 hover:text-neutral-300 transition-colors self-start"
					>
						// BACK_TO_DASHBOARD
					</a>

					<section
						class="border border-neutral-800 bg-neutral-900/30 rounded-xl p-8 backdrop-blur-sm rigid-card system-card"
					>
						<div
							class="flex items-center justify-between border-b border-neutral-800/60 pb-3 mb-5 font-mono text-[10px] text-neutral-500"
						>
							<div class="flex items-center gap-1.5">
								<svg
									xmlns="http://www.w3.org/2000/svg"
									width="11"
									height="11"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2.5"
									stroke-linecap="round"
									stroke-linejoin="round"
									class="text-emerald-500"
									><polyline points="4 17 10 11 4 5"
									></polyline><line
										x1="12"
										y1="19"
										x2="20"
										y2="19"></line></svg
								>
								<span class="terminal-path"
									>~/case_study/unified_intake_spatial_mapping.md</span
								>
							</div>
							<span>[STABLE]</span>
						</div>
						<span
							class="text-[10px] font-mono text-neutral-500 uppercase tracking-widest"
							>// Case Study</span
						>
						<h1
							class="text-3xl font-bold mt-2 mb-4 tracking-tight text-neutral-100"
						>
							Unified Intake & Spatial Mapping Engine
						</h1>
						<p
							class="text-neutral-400 leading-relaxed text-sm md:text-base"
						>
							A complete restructuring of a legacy government
							profiling form into a dynamic relational intake
							system featuring zero-friction GIS coordinate
							mapping.
						</p>

						<div class="flex flex-wrap gap-2 mt-6">
							<span
								class="px-2 py-1 text-xs font-mono rounded bg-neutral-900 text-neutral-400 border border-neutral-800"
								>Leaflet.js</span
							>
							<span
								class="px-2 py-1 text-xs font-mono rounded bg-neutral-900 text-neutral-400 border border-neutral-800"
								>Dynamic DOM Repeater</span
							>
							<span
								class="px-2 py-1 text-xs font-mono rounded bg-neutral-900 text-neutral-400 border border-neutral-800"
								>Vanilla JS State</span
							>
							<span
								class="px-2 py-1 text-xs font-mono rounded bg-neutral-900 text-neutral-400 border border-neutral-800"
								>DSWD Pag Abot</span
							>
						</div>
					</section>

					<section
						class="border border-neutral-800 bg-neutral-900/10 rounded-xl p-8 flex flex-col gap-6 rigid-card system-card"
					>
						<div
							class="flex items-center justify-between border-b border-neutral-800/60 pb-3 mb-1 font-mono text-[10px] text-neutral-500"
						>
							<div class="flex items-center gap-1.5">
								<svg
									xmlns="http://www.w3.org/2000/svg"
									width="11"
									height="11"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2.5"
									stroke-linecap="round"
									stroke-linejoin="round"
									class="text-blue-500/90"
									><rect
										width="20"
										height="16"
										x="2"
										y="4"
										rx="2"></rect><path d="M6 8h.01"
									></path><path d="M10 8h.01"></path><path
										d="M14 8h.01"></path></svg
								>
								<span class="terminal-path"
									>~/case_study/bottleneck_analysis.md</span
								>
							</div>
							<span>[ANALYZED]</span>
						</div>
						<div>
							<h2
								class="text-lg font-bold text-neutral-200 mb-3 tracking-tight"
							>
								// THE BOTTLENECK & THE TASK
							</h2>
							<p
								class="text-neutral-400 text-sm leading-relaxed mb-4"
							>
								The Pag Abot Program targets individuals and
								families in street situations (FISS), providing
								critical social rescue and long-term
								reintegration. When field operations deployed,
								operators faced massive frictional gridlock
								caused by their core data-collection tool: <strong
									>the legacy intake form was rigid and
									address-dependent.</strong
								>
							</p>
							<p
								class="text-neutral-400 text-sm leading-relaxed mb-4"
							>
								Because beneficiaries are frequently located
								under overpasses, on street corners, or near
								landmarks with zero structured physical
								addresses, traditional text logging broke.
								Furthermore, processing entire family structures
								was highly inefficient—the old interface could
								not scale fluidly to account for multiple family
								members encountered together on-site.
							</p>
							<p class="text-neutral-400 text-sm leading-relaxed">
								Prior development teams stalled trying to
								implement coordinate tracking and dynamic
								layouts. My supervisors handed me the task from
								scratch: refactor the entire collection
								component to introduce seamless, high-velocity
								profiling and multi-member data integrity within
								a unified workspace.
							</p>
						</div>

						<hr class="border-neutral-800/80" />

						<div>
							<h2
								class="text-lg font-bold text-neutral-200 mb-3 tracking-tight"
							>
								// INTENTIONALLY ENGINEERED ARCHITECTURE
							</h2>

							<h3
								class="text-xs font-mono text-neutral-300 uppercase tracking-wider mb-2 mt-4"
							>
								1. Relational Intake Form & Dynamic Sub-Form
								Repeater
							</h3>
							<p
								class="text-neutral-400 text-sm leading-relaxed mb-4"
							>
								To maximize field intake speed, I re-engineered
								the legacy fill-up form into a responsive, clean
								DOM controller. I integrated a specific
								classification toggle that allowed operators to
								instantly flag an individual's location context
								(e.g., street-level environment vs. structured
								shelter).
							</p>
							<p
								class="text-neutral-400 text-sm leading-relaxed mb-4"
							>
								To map families cohabiting in these
								environments, I engineered a **dynamic nested
								sub-form repeater**. Instead of routing
								operators through complex secondary pages, a
								single button click instantly instantiates and
								injects a clean, secondary family intake
								container directly into the active view. Each
								sub-form automatically tracks relational
								data—binding the family member directly to the
								primary beneficiary node while maintaining field
								validation arrays on the client side.
							</p>

							<h3
								class="text-xs font-mono text-neutral-300 uppercase tracking-wider mb-2 mt-4"
							>
								2. Zero-Friction GIS Isolation: Leaflet over
								Google
							</h3>
							<p
								class="text-neutral-400 text-sm leading-relaxed mb-4"
							>
								When adding the cartographic tracking layer, the
								mainstream solution was Google Maps API.
								However, this presented organizational friction:
								it required billing profiles, API key bindings,
								and permanent account setups. Because I was
								developing this as an intern, tying critical
								infrastructure to temporary profiles risked
								severe deployment issues later.
							</p>
							<p
								class="text-neutral-400 text-sm leading-relaxed mb-4"
							>
								Prioritizing a **seamless, frictionless
								corporate handoff**, I integrated <strong
									>Leaflet.js</strong
								>. It was light, fast, customizable, and ran
								entirely token-free, allowing the team to adopt
								the code base instantly with absolute zero
								authentication management or billing
								configuration overhead.
							</p>

							<h3
								class="text-xs font-mono text-neutral-300 uppercase tracking-wider mb-2 mt-4"
							>
								3. Reclaiming Dormant Database Schemas
							</h3>
							<p
								class="text-neutral-400 text-sm leading-relaxed mb-4"
							>
								Completed in a rapid 3-to-4 day development
								cycle, my prototype was wired straight into the
								application's underlying submission pipeline.
								During my analysis of the core application
								layout, I discovered that the existing database
								schema and system API already possessed
								unmapped, dormant spatial coordinate columns
								that were sitting completely unused.
							</p>
							<p
								class="text-neutral-400 text-sm leading-relaxed mb-4"
							>
								I calibrated the dynamic form's payload format
								to feed latitude/longitude data directly into
								those exact waiting structures, passing data
								safely through the pre-configured backend API
								guardrails without needing any server-side
								database refactoring.
							</p>

							<h3
								class="text-xs font-mono text-neutral-300 uppercase tracking-wider mb-2 mt-4"
							>
								4. Defeating the Leaflet Container Trap
							</h3>
							<p
								class="text-neutral-400 text-sm leading-relaxed mb-4"
							>
								Embedding this new layout inside our clean,
								accordion-style project tracking dashboard
								introduced a layout failure: initializing a
								Leaflet instance inside a hidden element
								(`display: none`) strips its capability to
								calculate real layout widths. When expanded, the
								map would render corrupted tiles and shattered
								boundaries.
							</p>
							<p
								class="text-neutral-400 text-sm leading-relaxed mb-4"
							>
								I resolved this defensively by listening
								exclusively to the container card's `'toggle'`
								event. The GIS layer only initializes when
								physical heights are accurately computed in the
								DOM:
							</p>

							<div
								class="bg-neutral-950 border border-neutral-800 rounded-lg p-4 font-mono text-xs text-neutral-300 overflow-x-auto leading-relaxed mb-6"
							>
								<span class="text-neutral-500"
									>// Initialize GIS layer only when accordion
									actively opens to preserve layout heights</span
								><br />
								card.addEventListener(<span
									class="text-emerald-400">'toggle'</span
								>, () =&gt; &#123;<br />
								&nbsp;&nbsp;<span class="text-amber-400"
									>if</span
								> (card.open && !mapInitialized) &#123;<br />
								&nbsp;&nbsp;&nbsp;&nbsp;initializeMapEngine();<br
								/>
								&nbsp;&nbsp;&#125;<br />
								&#125;);
							</div>
						</div>
					</section>

					<section
						id="interactive-simulation-card"
						class="border border-neutral-800 bg-neutral-900/30 rounded-xl p-6 md:p-8 flex flex-col gap-6 rigid-card system-card"
					>
						<div
							class="flex items-center justify-between border-b border-neutral-800/60 pb-3 mb-1 font-mono text-[10px] text-neutral-500"
						>
							<div class="flex items-center gap-1.5">
								<svg
									xmlns="http://www.w3.org/2000/svg"
									width="11"
									height="11"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2.5"
									stroke-linecap="round"
									stroke-linejoin="round"
									class="text-amber-500/90"
									><path d="m12 3-1.912 5.886h6.224z"
									></path><path d="m12 21 1.912-5.886H7.676z"
									></path><path d="m3 12 5.886 1.912V7.676z"
									></path><path d="m21 12-5.886-1.912v6.224z"
									></path></svg
								>
								<span class="terminal-path"
									>~/case_study/system_simulation.exe</span
								>
							</div>
							<span>[SANDBOX_READY]</span>
						</div>
						<div class="flex flex-col gap-1.5">
							<div class="flex items-center justify-between">
								<div class="flex items-center gap-2">
									<span
										id="sim-status-pulse"
										class="h-1.5 w-1.5 rounded-full bg-neutral-700 transition-all duration-700"
									></span>
									<span
										id="sim-status-text"
										class="text-[10px] font-mono text-neutral-500 uppercase tracking-widest transition-all duration-700"
										>// Sandbox Environment: Standby</span
									>
								</div>
							</div>
							<h2
								class="text-lg font-bold text-neutral-200 tracking-tight"
							>
								// INTERACTIVE SYSTEM SIMULATION
							</h2>
							<p
								class="text-neutral-400 text-xs mt-1 leading-relaxed"
							>
								A standalone reconstruction of the operational
								workspace originally built with Vue.js. Interact
								with the form parameters, expand family units,
								and drop map markers to monitor structural
								payload mutations live.
							</p>
						</div>

						<div
							class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start"
						>
							<div
								class="lg:col-span-7 border border-neutral-800/80 bg-neutral-950 rounded-xl p-5 flex flex-col gap-4"
							>
								<div
									class="flex items-center justify-between border-b border-neutral-800 pb-3"
								>
									<span
										class="text-xs font-mono font-bold tracking-tight text-neutral-300"
										>PRIMARY_INTAKE_CONTROLLER</span
									>
									<div class="flex items-center gap-2">
										<label
											class="text-[10px] font-mono text-neutral-500 uppercase"
											>Street Context:</label
										>
										<button
											id="sim-context-toggle"
											class="px-2 py-0.5 text-[10px] font-mono font-bold rounded bg-amber-500/10 text-amber-400 border border-amber-500/20 hover:bg-amber-500/20 transition-all select-none cursor-pointer"
										>
											STREET_SITUATION
										</button>
									</div>
								</div>

								<div class="grid grid-cols-2 gap-3 text-xs">
									<div class="flex flex-col gap-1">
										<label
											class="font-mono text-[10px] text-neutral-500"
											>BENEFICIARY_NAME</label
										>
										<input
											id="sim-input-name"
											type="text"
											value="Gerard Dominic"
											class="bg-neutral-900 border border-neutral-800 text-neutral-200 rounded px-2.5 py-1.5 focus:outline-none focus:border-neutral-700 font-mono text-xs"
										/>
									</div>
									<div class="flex flex-col gap-1">
										<label
											class="font-mono text-[10px] text-neutral-500"
											>CAPTURED_COORDINATES</label
										>
										<div
											class="grid grid-cols-2 gap-1 font-mono text-[11px]"
										>
											<div
												class="bg-neutral-900 border border-neutral-800 text-neutral-400 px-2 py-1.5 rounded flex justify-between"
											>
												<span class="text-neutral-600"
													>LAT:</span
												><span id="sim-lat">14.654</span
												>
											</div>
											<div
												class="bg-neutral-900 border border-neutral-800 text-neutral-400 px-2 py-1.5 rounded flex justify-between"
											>
												<span class="text-neutral-600"
													>LNG:</span
												><span id="sim-lng"
													>121.049</span
												>
											</div>
										</div>
									</div>
								</div>

								<div class="flex flex-col gap-2 mt-2">
									<div
										class="flex items-center justify-between"
									>
										<span
											class="font-mono text-[10px] text-neutral-400 tracking-wider"
											>// RELATED_DEPENDENTS_REGISTRY</span
										>
										<button
											id="sim-add-member-btn"
