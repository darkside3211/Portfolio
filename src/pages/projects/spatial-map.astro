							<div
								class="lg:col-span-5 flex flex-col gap-4 w-full"
							>
								<div
									class="border border-neutral-800 rounded-xl overflow-hidden h-[280px] bg-neutral-950 relative z-10 w-full"
									id="sim-map-canvas"
								>
								</div>

								<div
									class="border border-neutral-800 bg-neutral-950 rounded-xl p-4 font-mono text-[10px] flex flex-col gap-2"
								>
									<span
										class="text-neutral-500 tracking-wider"
										>// REAL-TIME PAYLOAD OBJECT STREAM
										(STAGED SCHEMA)</span
									>
									<pre
										id="sim-payload-json"
										class="text-emerald-400 leading-normal max-h-[120px] overflow-y-auto text-left">
									</pre>

									<div
										class="border-t border-neutral-800/80 pt-2.5 mt-1 flex flex-col gap-2"
									>
										<button
											id="sim-submit-btn"
											class="w-full bg-emerald-500/10 hover:bg-emerald-500/20 border border-emerald-500/30 hover:border-emerald-500/50 text-emerald-400 font-mono text-[10px] py-1.5 rounded transition-all cursor-pointer select-none"
										>
											SUBMIT_PAYLOAD_TO_API
										</button>
										<div
											id="sim-api-console"
											class="bg-neutral-900 border border-neutral-800/80 rounded p-2 text-neutral-500 text-[9px] min-h-[45px] max-h-[70px] overflow-y-auto leading-relaxed"
										>
											Console: Idle. Ready for payload
											submission...
										</div>
									</div>
