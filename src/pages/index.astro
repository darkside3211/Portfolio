---
// src/pages/index.astro
import "../styles/global.css";
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Gerard Baldo | System-First Engineer</title>
		<script is:inline>
			(function () {
				const savedTheme = localStorage.getItem("theme");
				if (savedTheme === "light") {
					document.documentElement.classList.add("light");
				} else {
					document.documentElement.classList.remove("light");
				}
			})();
		</script>
		<style>
			/* 1. Dot-Matrix Grid Layer Canvas mapping */
			body {
				background-image: radial-gradient(
					rgba(63, 63, 70, 0.25) 1px,
					transparent 1px
				);
				background-size: 20px 20px;
			}
			:global(.light) body {
				background-image: radial-gradient(
					rgba(181, 173, 148, 0.4) 1px,
					transparent 1px
				);
			}

			/* 2. Rigid Brutalist Shadow Mappings */
			.rigid-card {
				box-shadow: 4px 4px 0px 0px rgba(0, 0, 0, 0.5);
				transition:
					transform 0.2s cubic-bezier(0.16, 1, 0.3, 1),
					box-shadow 0.2s cubic-bezier(0.16, 1, 0.3, 1);
			}
			.rigid-card:hover {
				transform: translate(-1px, -1px);
				box-shadow: 5px 5px 0px 0px rgba(0, 0, 0, 0.6);
			}
			:global(.light) .rigid-card {
				box-shadow: 4px 4px 0px 0px rgba(42, 40, 34, 0.08);
			}
			:global(.light) .rigid-card:hover {
				box-shadow: 5px 5px 0px 0px rgba(42, 40, 34, 0.12);
			}

			/* 3. Smooth Collapsible Accordion Animations */
			@keyframes accordionSlide {
				from {
					opacity: 0;
					transform: translateY(-6px);
				}
				to {
					opacity: 1;
					transform: translateY(0);
				}
			}
			details[open] > *:not(summary) {
				animation: accordionSlide 0.25s cubic-bezier(0.16, 1, 0.3, 1)
					forwards;
			}
		</style>
	</head>
	<body
		class="bg-neutral-950 text-neutral-100 font-sans selection:bg-neutral-800 antialiased"
	>
		<div class="flex min-h-screen">
			<aside
				class="fixed top-0 left-0 h-screen w-64 border-r border-neutral-800 bg-neutral-950 p-6 flex flex-col justify-between z-50"
			>
				<div class="flex flex-col gap-8">
					<div class="flex flex-col gap-3">
						<div
							class="h-14 w-14 rounded-lg bg-neutral-900 border border-neutral-800 flex items-center justify-center text-lg font-bold tracking-tight text-neutral-300"
						>
							GB
						</div>
						<div>
							<h2
								class="font-semibold text-neutral-200 tracking-tight"
							>
								Gerard Baldo
							</h2>
							<p class="text-xs text-neutral-500 font-mono">
								System-First Engineer
							</p>
						</div>
					</div>

					<nav class="flex flex-col gap-2 text-sm">
						<a
							href="#manifesto"
							class="group flex items-center gap-2 text-neutral-400 hover:text-neutral-100 transition-colors py-1.5 font-medium font-mono text-xs tracking-wider"
						>
							<svg
								xmlns="http://www.w3.org/2000/svg"
								width="13"
								height="13"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								class="text-neutral-600 group-hover:text-neutral-400 transition-colors"
								><path
									d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"
								></path><polyline points="14 2 14 8 20 8"
								></polyline></svg
							>
							01. MANIFESTO
						</a>
						<a
							href="#capabilities"
							class="group flex items-center gap-2 text-neutral-400 hover:text-neutral-100 transition-colors py-1.5 font-medium font-mono text-xs tracking-wider"
						>
							<svg
								xmlns="http://www.w3.org/2000/svg"
								width="13"
								height="13"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								class="text-neutral-600 group-hover:text-neutral-400 transition-colors"
								><rect width="18" height="18" x="3" y="3" rx="2"
								></rect><path d="M9 3v18"></path><path
									d="M15 3v18"></path><path d="M3 9h18"
								></path><path d="M3 15h18"></path></svg
							>
							02. CAPABILITIES
						</a>
						<a
							href="#projects"
							class="group flex items-center gap-2 text-neutral-400 hover:text-neutral-100 transition-colors py-1.5 font-medium font-mono text-xs tracking-wider"
						>
							<svg
								xmlns="http://www.w3.org/2000/svg"
								width="13"
								height="13"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								class="text-neutral-600 group-hover:text-neutral-400 transition-colors"
								><path d="m7.5 4.27 9 5.15"></path><path
									d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"
								></path><path d="m3.3 7 8.7 5 8.7-5"
								></path><path d="M12 22V12"></path></svg
							>
							03. PROJECTS_AREA
						</a>
					</nav>
				</div>

				<div class="flex flex-col gap-4">
					<button
						id="theme-toggle"
						class="flex items-center justify-between w-full border border-neutral-800 hover:border-neutral-700 bg-neutral-900/10 hover:bg-neutral-900/30 text-neutral-400 hover:text-neutral-200 transition-all rounded px-3 py-2 text-xs font-mono select-none cursor-pointer"
					>
						<span>THEME: DEFAULT (DARK)</span>
						<span id="theme-icon">☼</span>
					</button>

					<div
						class="text-[10px] text-neutral-500 font-mono flex items-center gap-2 tracking-tight"
					>
						<span
							class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"
						></span>
						<span>ENVIRONMENT: ACTIVE</span>
					</div>
				</div>
			</aside>

			<!-- UPDATED: Wider constraint and asymmetric grid layout -->
			<main
				class="ml-64 flex-1 px-8 md:px-16 py-16 max-w-6xl grid grid-cols-1 lg:grid-cols-12 gap-8 items-start"
			>
				<!-- LEFT COLUMN: Content Column (Spans 8 of 12 columns) -->
				<div class="lg:col-span-8 flex flex-col gap-12">
					<section
						id="manifesto"
						class="border border-neutral-800 bg-neutral-900/30 rounded-xl p-8 backdrop-blur-sm scroll-mt-16 rigid-card system-card"
					>
						<div
							class="flex items-center justify-between border-b border-neutral-800/60 pb-3 mb-5 font-mono text-[10px] text-neutral-500"
						>
							<div class="flex items-center gap-1.5">
								<svg
									xmlns="http://www.w3.org/2000/svg"
									width="11"
									height="11"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2.5"
									stroke-linecap="round"
									stroke-linejoin="round"
									class="text-emerald-500"
									><polyline points="4 17 10 11 4 5"
									></polyline><line
										x1="12"
										y1="19"
										x2="20"
										y2="19"></line></svg
								>
								<span class="terminal-path">~/manifesto/core_philosophy.md</span>
							</div>
							<span>[STABLE]</span>
						</div>
						<span
							class="text-[10px] font-mono text-neutral-500 uppercase tracking-widest"
							>// Core Philosophy</span
						>
						<h1
							class="text-2xl font-bold mt-2 mb-4 tracking-tight text-neutral-100"
						>
							System Over Syntax
						</h1>
						<!-- De-textified Spec Grid -->
						<div class="font-mono text-xs space-y-4 border-t border-neutral-800/60 pt-4 mt-6">
							<div class="grid grid-cols-3 gap-2">
								<span class="text-neutral-500">[CONSTANTS]</span>
								<span class="col-span-2 text-neutral-200 font-semibold">Fundamental Architecture, Data Integrity</span>
							</div>
							<div class="grid grid-cols-3 gap-2">
								<span class="text-neutral-500">[VARIABLES]</span>
								<span class="col-span-2 text-neutral-400 italic">Framework Syntaxes, Language Trends</span>
							</div>
							<div class="grid grid-cols-3 gap-2 border-b border-neutral-800/40 pb-4">
								<span class="text-neutral-500">[CORE_VALUE]</span>
								<span class="col-span-2 text-neutral-300 leading-relaxed">
									Value isn't built on memorizing documentation that can be looked up in seconds. It is built on structural execution.
								</span>
							</div>

							<!-- Runtime Capabilities Checklist -->
							<div class="space-y-2.5 pt-2">
								<div class="text-neutral-500 font-bold uppercase text-[9px] tracking-wider">// OPERATIONAL_CAPABILITIES</div>
								<div class="flex items-start gap-2 text-neutral-400">
									<span class="text-amber-500">■</span>
									<span><strong class="text-neutral-200">Trace Data Flows:</strong> Explicit cross-stack pipeline mapping under high load.</span>
								</div>
								<div class="flex items-start gap-2 text-neutral-400">
									<span class="text-amber-500">■</span>
									<span><strong class="text-neutral-200">Isolate Failures:</strong> Rapid root-cause diagnosis of platform vectors under pressure.</span>
								</div>
								<div class="flex items-start gap-2 text-neutral-400">
									<span class="text-amber-500">■</span>
									<span><strong class="text-neutral-200">Environment Adaptability:</strong> Deciphering complex legacy technical codebases quickly.</span>
								</div>
							</div>
						</div>
					</section>

					<section
						id="capabilities"
						class="border border-neutral-800 bg-neutral-900/30 rounded-xl p-8 backdrop-blur-sm scroll-mt-16 rigid-card system-card"
					>
						<div
							class="flex items-center justify-between border-b border-neutral-800/60 pb-3 mb-5 font-mono text-[10px] text-neutral-500"
						>
							<div class="flex items-center gap-1.5">
								<svg
									xmlns="http://www.w3.org/2000/svg"
									width="11"
									height="11"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2.5"
									stroke-linecap="round"
									stroke-linejoin="round"
									class="text-blue-500/90"
									><rect
										width="20"
										height="16"
										x="2"
										y="4"
										rx="2"></rect><path d="M6 8h.01"
									></path><path d="M10 8h.01"></path><path
										d="M14 8h.01"></path></svg
								>
								<span class="terminal-path">~/workbench/operational_bounds.sys</span>
							</div>
							<span>[READY]</span>
						</div>
						<span
							class="text-[10px] font-mono text-neutral-500 uppercase tracking-widest"
							>// Operational Bounds</span
						>
						<h2
							class="text-xl font-bold mt-2 mb-4 tracking-tight text-neutral-200"
						>
							Cognitive Framework & Toolkit
						</h2>
						<div
							class="grid grid-cols-1 md:grid-cols-2 gap-6 text-sm"
						>
							<div
								class="border border-neutral-800/60 bg-neutral-950/40 rounded-lg p-4"
							>
								<h3
									class="font-semibold text-neutral-300 mb-2 font-mono text-xs uppercase tracking-wider text-neutral-400"
								>
									Implementation Stack
								</h3>
								<p
									class="text-neutral-400 leading-relaxed text-xs"
								>
									Vue.js interface orchestration, PHP Laravel
									backend pipelines, and system-agnostic
									structural programming logic.
								</p>
							</div>
							<div
								class="border border-neutral-800/60 bg-neutral-950/40 rounded-lg p-4"
							>
								<h3
									class="font-semibold text-neutral-300 mb-2 font-mono text-xs uppercase tracking-wider text-neutral-400"
								>
									Validation Guardrails
								</h3>
								<p
									class="text-neutral-400 leading-relaxed text-xs"
								>
									Playwright, Selenium, and Cypress automated
									testing suites alongside rigorous Postman
									API integration probing.
								</p>
							</div>
						</div>
					</section>

					<section
						id="projects"
						class="flex flex-col gap-4 scroll-mt-16"
					>
						<span
							class="text-[10px] font-mono text-neutral-500 uppercase tracking-widest"
							>// The Evidence</span
						>
						<h2
							class="text-xl font-bold tracking-tight mb-2 text-neutral-200"
						>
							Projects Area
						</h2>

						<details
							name="portfolio-projects"
							class="group border border-neutral-800 bg-neutral-900/10 rounded-xl overflow-hidden transition-all duration-300 open:bg-neutral-900/40 open:border-neutral-700 rigid-card system-card"
						>
							<summary
								class="flex justify-between items-center p-6 cursor-pointer list-none select-none hover:bg-neutral-900/30 transition-colors"
							>
								<div
									class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-4"
								>
									<h3
										class="font-bold text-neutral-300 tracking-tight group-open:text-neutral-100"
									>
										DSWD Cross-Stack Optimization
									</h3>
									<div class="flex gap-1.5">
										<span
											class="inline-flex items-center gap-1.5 px-2 py-0.5 text-[10px] font-mono rounded bg-neutral-800 text-neutral-400 border border-neutral-700"
										>
											<svg
												xmlns="http://www.w3.org/2000/svg"
												width="11"
												height="11"
												viewBox="0 0 24 24"
												fill="none"
												stroke="currentColor"
												stroke-width="2.5"
												stroke-linecap="round"
												stroke-linejoin="round"
												class="text-red-500/90"
												><path
													d="m12 3-1.912 5.886h6.224z"
												></path><path
													d="m12 21 1.912-5.886H7.676z"
												></path><path
													d="m3 12 5.886 1.912V7.676z"
												></path><path
													d="m21 12-5.886-1.912v6.224z"
												></path></svg
											>
											Laravel
										</span>
										<span
											class="inline-flex items-center gap-1.5 px-2 py-0.5 text-[10px] font-mono rounded bg-neutral-800 text-neutral-400 border border-neutral-700"
										>
											<svg
												xmlns="http://www.w3.org/2000/svg"
												width="11"
												height="11"
												viewBox="0 0 24 24"
												fill="none"
												stroke="currentColor"
												stroke-width="2.5"
												stroke-linecap="round"
												stroke-linejoin="round"
												class="text-emerald-500/90"
												><path d="m2 3 10 18L22 3"
												></path><path
													d="m6.5 3 5.5 10 5.5-10"
												></path></svg
											>
											Vue.js
										</span>
									</div>
								</div>
								<span
									class="text-neutral-500 group-open:rotate-180 transition-transform duration-300 text-xs font-mono"
									>▼</span
								>
							</summary>

							<div
								class="p-6 border-t border-neutral-800 grid grid-cols-1 lg:grid-cols-12 gap-6 bg-neutral-950/20"
							>
								<div
									class="lg:col-span-7 flex flex-col gap-4 text-xs md:text-sm text-neutral-400 leading-relaxed"
								>
									<p>
										<strong class="text-neutral-300"
											>The Context:</strong
										> Debugging validation bottlenecks for an
										active government web application framework
										in production.
									</p>
									<p>
										<strong class="text-neutral-300"
											>The Discovery:</strong
										> Traced a failure cascade where valid client
										payloads were systematically dropping out
										due to improper backend data sanitization
										and strict validation mismatches.
									</p>
									<p>
										<strong class="text-neutral-300"
											>The Solution:</strong
										> Restructured inputs safely across interface
										boundaries and ran target validation requests
										to ensure data integrity.
									</p>
								</div>
								<div
									id="live-sandbox-metrics"
									class="lg:col-span-5 bg-neutral-950 border border-neutral-800 rounded-lg h-40 p-4 font-mono text-[10px] flex flex-col gap-2 overflow-y-auto"
								>
									<div
										class="flex justify-between items-center text-neutral-500 border-b border-neutral-900/60 pb-1.5 mb-1"
									>
										<span>// LIVE_VALIDATION_LOGGER</span>
										<span class="flex items-center gap-1.5">
											<span
												id="sandbox-pulse"
												class="h-1.5 w-1.5 rounded-full bg-neutral-700"
											></span>
											<span
												id="sandbox-status"
												class="uppercase text-[9px]"
												>IDLE</span
											>
										</span>
									</div>
									<div
										id="sandbox-log-entries"
										class="flex flex-col gap-1 text-neutral-500 italic"
									>
										Waiting for system boundary telemetry...
									</div>
								</div>
							</div>
						</details>

						<details
							id="map-project-card"
							name="portfolio-projects"
							class="group border border-neutral-800 bg-neutral-900/10 rounded-xl overflow-hidden transition-all duration-300 open:bg-neutral-900/40 open:border-neutral-700 rigid-card system-card"
						>
							<summary
								class="flex justify-between items-center p-6 cursor-pointer list-none select-none hover:bg-neutral-900/30 transition-colors"
							>
								<div
									class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-4"
								>
									<h3
										class="font-bold text-neutral-300 tracking-tight group-open:text-neutral-100"
									>
										Unified Intake & Spatial Mapping Engine
									</h3>
									<div class="flex gap-1.5">
										<span
											class="inline-flex items-center gap-1.5 px-2 py-0.5 text-[10px] font-mono rounded bg-neutral-800 text-neutral-400 border border-neutral-700"
										>
											<svg
												xmlns="http://www.w3.org/2000/svg"
												width="11"
												height="11"
												viewBox="0 0 24 24"
												fill="none"
												stroke="currentColor"
												stroke-width="2.5"
												stroke-linecap="round"
												stroke-linejoin="round"
												class="text-amber-500/90"
												><path
													d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"
												></path><circle
													cx="12"
													cy="10"
													r="3"></circle></svg
											>
											Leaflet.js
										</span>
										<span
											class="inline-flex items-center gap-1.5 px-2 py-0.5 text-[10px] font-mono rounded bg-neutral-800 text-neutral-400 border border-neutral-700"
										>
											<svg
												xmlns="http://www.w3.org/2000/svg"
												width="11"
												height="11"
												viewBox="0 0 24 24"
												fill="none"
												stroke="currentColor"
												stroke-width="2.5"
												stroke-linecap="round"
												stroke-linejoin="round"
												class="text-blue-500/90"
												><rect
													width="18"
													height="18"
													x="3"
													y="3"
													rx="2"></rect><path
													d="M12 8v8"></path><path
													d="M8 12h8"></path></svg
											>
											Dynamic DOM Repeater
										</span>
										<span
											class="inline-flex items-center gap-1.5 px-2 py-0.5 text-[10px] font-mono rounded bg-neutral-800 text-neutral-400 border border-neutral-700"
										>
											<svg
												xmlns="http://www.w3.org/2000/svg"
												width="11"
												height="11"
												viewBox="0 0 24 24"
												fill="none"
												stroke="currentColor"
												stroke-width="2.5"
												stroke-linecap="round"
												stroke-linejoin="round"
												class="text-yellow-500/90"
												><path d="M12 2v20"></path><path
													d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"
												></path></svg
											>
											Vanilla JS State
										</span>
									</div>
								</div>
								<span
									class="text-neutral-500 group-open:rotate-180 transition-transform duration-300 text-xs font-mono"
									>▼</span
								>
							</summary>

							<div
								class="p-6 border-t border-neutral-800 grid grid-cols-1 lg:grid-cols-12 gap-6 bg-neutral-950/20"
							>
								<div
									class="lg:col-span-5 flex flex-col gap-4 text-xs md:text-sm text-neutral-400 leading-relaxed"
								>
									<a
										href="/projects/spatial-map"
										class="inline-flex items-center justify-between w-full border border-neutral-800 hover:border-neutral-700 bg-neutral-900/10 hover:bg-neutral-900/30 text-neutral-400 hover:text-neutral-200 transition-all rounded px-3 py-2 text-xs font-mono select-none"
									>
										<span>VIEW_CASE_STUDY</span>
										<span>➔</span>
									</a>

									<p>
										<strong class="text-neutral-300"
											>The Context:</strong
										> A complete restructuring of a legacy government
										profiling form into a dynamic relational intake
										system featuring zero-friction GIS coordinate
										mapping.
									</p>
									<p>
										<strong class="text-neutral-300"
											>Relational & Dynamic:</strong
										> Re-engineered a rigid intake layout into
										a responsive DOM controller with dynamic nested
										sub-form repeaters for multi-member data integrity.
									</p>
									<p>
										<strong class="text-neutral-300"
											>Constraint-Driven GIS:</strong
										> Implemented Leaflet.js over Google Maps
										to ensure a zero-friction handoff, feeding
										validated vectors directly into dormant database
										columns.
									</p>

									<div
										class="mt-2 border border-neutral-800/80 rounded-lg p-3 bg-neutral-950/40"
									>
										<h4
											class="text-xs font-mono text-neutral-400 uppercase tracking-wider mb-2"
										>
											// Saved Registry
										</h4>
										<ul
											id="saved-locations-list"
											class="flex flex-col gap-1.5 text-xs text-neutral-500 max-h-24 overflow-y-auto"
										>
											<li
												id="empty-registry-msg"
												class="italic"
											>
												No locations committed to memory
												yet.
											</li>
										</ul>
									</div>
								</div>

								<div class="lg:col-span-7 flex flex-col gap-3">
									<link
										rel="stylesheet"
										href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
										crossorigin=""
									/>
									<div
										id="map"
										class="w-full h-64 bg-neutral-950 border border-neutral-800 rounded-lg z-10"
									>
									</div>

									<div
										class="grid grid-cols-1 sm:grid-cols-3 gap-2 items-end"
									>
										<div>
											<label
												class="block text-[10px] font-mono text-neutral-500 uppercase tracking-wider mb-1"
												>Latitude (Y)</label
											>
											<input
												type="number"
												step="any"
												id="input-lat"
												value="12.8797"
												class="w-full bg-neutral-900 border border-neutral-800 rounded px-2.5 py-1.5 text-xs font-mono text-neutral-200 focus:outline-none focus:border-neutral-700 transition-colors"
											/>
										</div>
										<div>
											<label
												class="block text-[10px] font-mono text-neutral-500 uppercase tracking-wider mb-1"
												>Longitude (X)</label
											>
											<input
												type="number"
												step="any"
												id="input-lng"
												value="121.7740"
												class="w-full bg-neutral-900 border border-neutral-800 rounded px-2.5 py-1.5 text-xs font-mono text-neutral-200 focus:outline-none focus:border-neutral-700 transition-colors"
											/>
										</div>
										<button
											id="btn-save-coord"
											class="w-full bg-neutral-800 hover:bg-neutral-700 border border-neutral-700 text-neutral-200 font-mono text-xs py-1.5 rounded transition-colors font-medium active:bg-neutral-800"
										>
											COMMIT_PIN
										</button>
									</div>
								</div>
							</div>
						</details>
					</section>
				</div>

				<!-- RIGHT COLUMN: Fills that plain empty whitespace void (Spans 4 of 12 columns) -->
				<aside
					id="engine-metrics-card"
					class="lg:col-span-4 border border-neutral-800 bg-neutral-900/10 rounded-xl p-5 font-mono text-[11px] flex flex-col gap-4 rigid-card lg:sticky lg:top-16 backdrop-blur-sm cursor-pointer select-none system-card"
				>
					<div
						class="flex items-center justify-between border-b border-neutral-800/60 pb-2 text-neutral-400"
					>
						<span>// ENGINE_METRICS</span>
						<span class="h-2 w-2 engine-status-active"></span>
					</div>

					<div class="flex flex-col gap-2">
						<div class="flex justify-between text-neutral-500">
							<span>ENVIRONMENT:</span><span
								class="text-neutral-300">PRODUCTION</span
							>
						</div>
						<div class="flex justify-between text-neutral-500">
							<span>STACK:</span><span class="text-neutral-300"
								>ASTRO_VANILLA_JS</span
							>
						</div>
						<div class="flex justify-between text-neutral-500">
							<span>COMPILER_TARGET:</span><span
								class="text-neutral-300">ESNEXT</span
							>
						</div>
					</div>

					<hr class="border-neutral-800/60" />

					<div class="flex flex-col gap-1">
						<span
							class="text-neutral-500 font-bold uppercase text-[9px] tracking-wider"
							>// PLATFORM SOLUTIONS SPEC</span
						>
						<div
							class="bg-neutral-950/40 border border-neutral-800/80 rounded px-2.5 py-2 mt-1 flex flex-col gap-1.5 text-neutral-400"
						>
							<div class="flex items-center gap-2">
								<span class="text-emerald-500">✓</span>
								<span>Freshworks Solutions Engineer</span>
							</div>
							<div class="flex items-center gap-2">
								<span class="text-emerald-500">✓</span>
								<span>Implementation Specialist</span>
							</div>
						</div>
					</div>

					<div
						id="walkthrough-console"
						class="hidden border-t border-neutral-800/60 pt-4 mt-2 flex flex-col gap-3"
					>
						<span
							class="text-neutral-500 font-bold uppercase text-[9px] tracking-wider"
							>// SYSTEM_WALKTHROUGH</span
						>
						<div
							class="bg-neutral-950 border border-neutral-900 p-3 rounded font-mono text-[10px] flex flex-col gap-2.5 leading-relaxed text-neutral-400"
						>
							<div class="flex items-start gap-1.5">
								<span class="text-emerald-500 font-bold">01.</span>
								<div>
									<span class="text-neutral-200 font-bold">Astro Core:</span>
									Pre-renders pages to static HTML, shipping zero client JS.
								</div>
							</div>
							<div class="flex items-start gap-1.5">
								<span class="text-emerald-500 font-bold">02.</span>
								<div>
									<span class="text-neutral-200 font-bold">Tailwind compilation:</span>
									Utility classes bundle to minimal static stylesheet.
								</div>
							</div>
							<div class="flex items-start gap-1.5">
								<span class="text-emerald-500 font-bold">03.</span>
								<div>
									<span class="text-neutral-200 font-bold">Vanilla JS State:</span>
									Coordinates and maps load and bind on element initialization.
								</div>
							</div>
							<div
								class="text-[9px] text-neutral-500 border-t border-neutral-900/60 pt-1.5 mt-1"
							>
								Target: ESNEXT | Mode: Static Build
							</div>
						</div>
					</div>

					<!-- Live Telemetry Terminal Widget -->
					<div id="telemetry-widget" class="border border-neutral-800/80 rounded-lg p-4 bg-neutral-950/60 text-stone-200 font-mono text-[11px] leading-relaxed shadow-inner mt-4">
						<div class="flex items-center justify-between text-neutral-500 border-b border-neutral-900/60 pb-2 mb-2">
							<span>// COGNITIVE_SYSTEM_TELEMETRY</span>
							<span class="animate-pulse text-emerald-500 text-[9px] flex items-center gap-1">● LIVE</span>
						</div>
						
						<!-- Target container where our client script will stream logs -->
						<div id="telemetry-log-stream" class="space-y-1 min-h-[140px]">
							<!-- Baseline placeholder lines if JavaScript is initializing -->
							<div class="text-neutral-500">Initializing secure terminal socket...</div>
						</div>
					</div>
				</aside>
			</main>
		</div>

		<script
			is:inline
			src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
			crossorigin=""></script>

		<script is:inline>
			// Block execution until Leaflet CDN is fully mounted to window scope
			window.addEventListener("DOMContentLoaded", () => {
				const card = document.getElementById("map-project-card");
				let mapInitialized = false;
				let map, marker;

				// DOM Engine Selectors
				const latInput = document.getElementById("input-lat");
				const lngInput = document.getElementById("input-lng");
				const saveBtn = document.getElementById("btn-save-coord");
				const savedList = document.getElementById(
					"saved-locations-list",
				);
				const emptyMsg = document.getElementById("empty-registry-msg");

				// Local Array Cache for the Coordinates
				let savedRegistry = [];

				// DEFENSIVE EXECUTION: Initialize map engine only when the card toggles open
				card.addEventListener("toggle", () => {
					if (card.open && !mapInitialized) {
						initializeMapEngine();
					}
				});

				function initializeMapEngine() {
					// 1. Anchor Map view centered over the geographical Philippines
					map = L.map("map", { zoomControl: false }).setView(
						[12.8797, 121.774],
						5,
					);
					mapInitialized = true;

					// 2. Inject standard OpenStreetMap light tiles
					L.tileLayer(
						"https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
						{
							attribution:
								'&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank">OpenStreetMap</a> contributors',
						},
					).addTo(map);

					// Position default zoom controls to the bottom right out of the layout flow
					L.control.zoom({ position: "bottomright" }).addTo(map);

					// 3. Drop base starting marker instance
					const startLat = parseFloat(latInput.value);
					const startLng = parseFloat(lngInput.value);
					marker = L.marker([startLat, startLng], {
						draggable: true,
					}).addTo(map);

					// 4. MAP INTERACTION: Click to relocate pin
					map.on("click", (e) => {
						const { lat, lng } = e.latlng;
						updateSystemPosition(lat, lng);
					});

					// 5. MARKER INTERACTION: Dragging pin updates inputs manually
					marker.on("dragend", () => {
						const { lat, lng } = marker.getLatLng();
						updateInputsOnly(lat, lng);
					});

					// 6. INPUT INTERACTION: Typing values repositions map and pin
					[latInput, lngInput].forEach((input) => {
						input.addEventListener("input", () => {
							const lat = parseFloat(latInput.value);
							const lng = parseFloat(lngInput.value);
							if (!isNaN(lat) && !isNaN(lng)) {
								marker.setLatLng([lat, lng]);
								map.panTo([lat, lng]);
							}
						});
					});
				}

				function updateSystemPosition(lat, lng) {
					marker.setLatLng([lat, lng]);
					map.panTo([lat, lng]);
					updateInputsOnly(lat, lng);
				}

				function updateInputsOnly(lat, lng) {
					latInput.value = lat.toFixed(6);
					lngInput.value = lng.toFixed(6);
				}

				// DOM elements for telemetry sandbox sync
				const sandboxLogEntries = document.getElementById(
					"sandbox-log-entries",
				);
				const sandboxStatus = document.getElementById("sandbox-status");
				const sandboxPulse = document.getElementById("sandbox-pulse");

				function triggerSandboxLog(lat, lng) {
					if (!sandboxLogEntries || !sandboxStatus || !sandboxPulse)
						return;

					// Clear placeholder notice if it's the first time
					if (
						sandboxLogEntries.querySelector(".italic") ||
						sandboxLogEntries.innerHTML.includes(
							"Waiting for system",
						)
					) {
						sandboxLogEntries.innerHTML = "";
					}

					// Set status to validating
					sandboxStatus.textContent = "VALIDATING...";
					sandboxPulse.className =
						"h-1.5 w-1.5 rounded-full bg-amber-500 animate-pulse";

					const txId = Math.floor(1000 + Math.random() * 9000);
					const timeStr = new Date().toLocaleTimeString();

					// Create log entry
					const entry = document.createElement("div");
					entry.className =
						"text-[9px] text-neutral-400 font-mono border-l-2 border-amber-500/50 pl-1.5 py-0.5";
					entry.innerHTML = `[${timeStr}] TX_${txId}: VALIDATING INTAKE PAYLOAD {lat: ${lat.toFixed(4)}, lng: ${lng.toFixed(4)}}`;
					sandboxLogEntries.appendChild(entry);
					sandboxLogEntries.scrollTop =
						sandboxLogEntries.scrollHeight;

					// Trigger success state after 600ms simulation delay
					setTimeout(() => {
						entry.className =
							"text-[9px] text-neutral-300 font-mono border-l-2 border-emerald-500 pl-1.5 py-0.5";
						entry.innerHTML = `[${timeStr}] TX_${txId}: <span class="text-emerald-500">✓</span> POST_INTAKE_OK | SYNC: SUCCESS`;

						sandboxStatus.textContent = "ACTIVE";
						sandboxPulse.className =
							"h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse";
					}, 600);
				}

				// 7. NEW SPIN LOGIC: Committing and recalling pins from memory registry
				saveBtn.addEventListener("click", () => {
					const lat = parseFloat(latInput.value);
					const lng = parseFloat(lngInput.value);

					if (
						isNaN(lat) ||
						(!isNaN(lat) &&
							(lat < -90 || lat > 90 || lng < -180 || lng > 180))
					)
						return;

					const locationNode = { id: Date.now(), lat, lng };
					savedRegistry.push(locationNode);

					// Remove "Empty" notice upon first database commit
					if (emptyMsg) emptyMsg.remove();

					// Append clickable text node to interface list
					const li = document.createElement("li");
					li.className =
						"flex justify-between items-center bg-neutral-900/80 border border-neutral-800/60 rounded px-2 py-1 text-neutral-400 font-mono text-[11px] hover:border-neutral-700 hover:text-neutral-200 cursor-pointer transition-all";
					li.innerHTML = `<span>LOC_${locationNode.id.toString().slice(-4)} ➔ [${lat.toFixed(4)}, ${lng.toFixed(4)}]</span>`;

					// Clicking the list item recalls coordinate parameters and centers map
					li.addEventListener("click", () => {
						updateSystemPosition(
							locationNode.lat,
							locationNode.lng,
						);
					});

					savedList.appendChild(li);
					triggerSandboxLog(lat, lng);
				});

				// Theme Toggle Logic
				const themeToggleBtn = document.getElementById("theme-toggle");
				const themeIcon = document.getElementById("theme-icon");
				const themeText = themeToggleBtn.querySelector("span");

				function updateThemeUI(isLight) {
					if (isLight) {
						document.documentElement.classList.add("light");
						if (themeText)
							themeText.textContent = "THEME: BEIGE_MODE";
						if (themeIcon) themeIcon.textContent = "☾";
					} else {
						document.documentElement.classList.remove("light");
						if (themeText)
							themeText.textContent = "THEME: DEFAULT (DARK)";
						if (themeIcon) themeIcon.textContent = "☼";
					}
				}

				// Initialize UI state
				const isCurrentlyLight =
					document.documentElement.classList.contains("light");
				updateThemeUI(isCurrentlyLight);

				themeToggleBtn.addEventListener("click", () => {
					const isLight =
						document.documentElement.classList.toggle("light");
					localStorage.setItem("theme", isLight ? "light" : "dark");
					updateThemeUI(isLight);
				});

				// Walkthrough Console Toggle
				const engineCard = document.getElementById("engine-metrics-card");
				const walkthroughConsole = document.getElementById(
					"walkthrough-console",
				);

				if (engineCard && walkthroughConsole) {
					engineCard.addEventListener("click", () => {
						walkthroughConsole.classList.toggle("hidden");
						walkthroughConsole.classList.toggle("animate-fade-in");
						console.log(
							"System Walkthrough Initialized: Astro + Vanilla JS Target ESNEXT.",
						);
					});

					// Prevent clicks inside the walkthrough console from closing it
					walkthroughConsole.addEventListener("click", (e) => {
						e.stopPropagation();
					});
				}

				// Active Stream Controller Script for Telemetry Log
				const logContainer = document.getElementById("telemetry-log-stream");
				const telemetryWidget = document.getElementById("telemetry-widget");
				if (logContainer) {
					// Ordered sequence logs mapping back to your structural ecosystem
					const bootLogs = [
						{ type: 'OK', text: 'Kernel architecture verified via Astro core target [ESNEXT].' },
						{ type: 'OK', text: 'Interface orchestration matrix attached via Vue.js pipelines.' },
						{ type: 'OK', text: 'Data routing rules verified via PHP Laravel backend.' },
						{ type: 'OK', text: 'Validation guardrails online [Cypress, Playwright, Postman].' },
						{ type: 'SPEC', text: 'Freshworks Certified Solutions Specialist parameters matching.' },
						{ type: 'INFO', text: 'Listening for incoming integration webhook probes...' },
						{ type: 'READY', text: 'System completely idle. Awaiting client interaction.█' }
					];

					logContainer.innerHTML = ''; // Wipe initial server placeholder
					let currentLine = 0;

					function renderNextLogLine() {
						if (currentLine >= bootLogs.length) return;

						const lineData = bootLogs[currentLine];
						const row = document.createElement('div');
						
						// Syntax highlight styling based on status type
						let badge = `<span class="text-neutral-500">[SYS]</span>`;
						if (lineData.type === 'OK') badge = `<span class="text-emerald-400">[ OK ]</span>`;
						if (lineData.type === 'SPEC') badge = `<span class="text-amber-400">[SPEC]</span>`;
						if (lineData.type === 'INFO') badge = `<span class="text-sky-400">[INFO]</span>`;
						if (lineData.type === 'READY') badge = `<span class="text-emerald-400 animate-pulse">[RDY]</span>`;

						row.innerHTML = `${badge} <span class="text-neutral-300">${lineData.text}</span>`;
						row.className = 'opacity-0 transform translate-y-1 transition-all duration-300 ease-out';
						
						logContainer.appendChild(row);

						// Force repaint to trigger animation fade-in effect smoothly
						setTimeout(() => {
							row.classList.remove('opacity-0', 'translate-y-1');
						}, 10);

						currentLine++;
						// Natural stepping delay simulating network handshakes
						setTimeout(renderNextLogLine, Math.random() * 400 + 300);
					}

					// Initialize telemetry script playback
					setTimeout(renderNextLogLine, 400);
				}

				if (telemetryWidget) {
					// Prevent clicks inside the telemetry log container from toggling the walkthrough console
					telemetryWidget.addEventListener("click", (e) => {
						e.stopPropagation();
					});
				}
			});
		</script>
	</body>
</html>
