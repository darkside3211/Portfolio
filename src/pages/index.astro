					<!-- Live Telemetry Terminal Widget -->
					<div id="telemetry-widget" class="border border-neutral-800/80 rounded-lg p-4 bg-neutral-950/60 text-stone-200 font-mono text-[11px] leading-relaxed shadow-inner mt-4">
