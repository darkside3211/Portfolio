		<script is:inline>
			// Block execution until Leaflet CDN is fully mounted to window scope
			window.addEventListener("DOMContentLoaded", () => {
				const card = document.getElementById("map-project-card");
				let mapInitialized = false;
				let map, marker;

				// DOM Engine Selectors
				const latInput = document.getElementById("input-lat");
				const lngInput = document.getElementById("input-lng");
				const saveBtn = document.getElementById("btn-save-coord");
				const savedList = document.getElementById(
					"saved-locations-list",
				);
				const emptyMsg = document.getElementById("empty-registry-msg");

				// Local Array Cache for the Coordinates
				let savedRegistry = [];

				// DEFENSIVE EXECUTION: Initialize map engine only when the card toggles open
				card.addEventListener("toggle", () => {
					if (card.open && !mapInitialized) {
						initializeMapEngine();
					}
				});

				function initializeMapEngine() {
					// 1. Anchor Map view centered over the geographical Philippines
					map = L.map("map", { zoomControl: false }).setView(
						[12.8797, 121.774],
						5,
					);
					mapInitialized = true;

					// 2. Inject standard OpenStreetMap light tiles
					L.tileLayer(
						"https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
						{
							attribution:
								'&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank">OpenStreetMap</a> contributors',
						},
					).addTo(map);

					// Position default zoom controls to the bottom right out of the layout flow
					L.control.zoom({ position: "bottomright" }).addTo(map);

					// 3. Drop base starting marker instance
					const startLat = parseFloat(latInput.value);
					const startLng = parseFloat(lngInput.value);
					marker = L.marker([startLat, startLng], {
						draggable: true,
					}).addTo(map);

					// 4. MAP INTERACTION: Click to relocate pin
					map.on("click", (e) => {
						const { lat, lng } = e.latlng;
						updateSystemPosition(lat, lng);
					});

					// 5. MARKER INTERACTION: Dragging pin updates inputs manually
					marker.on("dragend", () => {
						const { lat, lng } = marker.getLatLng();
						updateInputsOnly(lat, lng);
					});

					// 6. INPUT INTERACTION: Typing values repositions map and pin
					[latInput, lngInput].forEach((input) => {
						input.addEventListener("input", () => {
							const lat = parseFloat(latInput.value);
							const lng = parseFloat(lngInput.value);
							if (!isNaN(lat) && !isNaN(lng)) {
								marker.setLatLng([lat, lng]);
								map.panTo([lat, lng]);
							}
						});
					});
				}

				function updateSystemPosition(lat, lng) {
					marker.setLatLng([lat, lng]);
					map.panTo([lat, lng]);
					updateInputsOnly(lat, lng);
				}

				function updateInputsOnly(lat, lng) {
					latInput.value = lat.toFixed(6);
					lngInput.value = lng.toFixed(6);
				}

				// DOM elements for telemetry sandbox sync
				const sandboxLogEntries = document.getElementById(
					"sandbox-log-entries",
				);
				const sandboxStatus = document.getElementById("sandbox-status");
				const sandboxPulse = document.getElementById("sandbox-pulse");

				function triggerSandboxLog(lat, lng) {
					if (!sandboxLogEntries || !sandboxStatus || !sandboxPulse)
						return;

					// Clear placeholder notice if it's the first time
					if (
						sandboxLogEntries.querySelector(".italic") ||
						sandboxLogEntries.innerHTML.includes(
							"Waiting for system",
						)
					) {
						sandboxLogEntries.innerHTML = "";
					}

					// Set status to validating
					sandboxStatus.textContent = "VALIDATING...";
					sandboxPulse.className =
						"h-1.5 w-1.5 rounded-full bg-amber-500 animate-pulse";

					const txId = Math.floor(1000 + Math.random() * 9000);
					const timeStr = new Date().toLocaleTimeString();

					// Create log entry
					const entry = document.createElement("div");
					entry.className =
						"text-[9px] text-neutral-400 font-mono border-l-2 border-amber-500/50 pl-1.5 py-0.5";
					entry.innerHTML = `[${timeStr}] TX_${txId}: VALIDATING INTAKE PAYLOAD {lat: ${lat.toFixed(4)}, lng: ${lng.toFixed(4)}}`;
					sandboxLogEntries.appendChild(entry);
					sandboxLogEntries.scrollTop =
						sandboxLogEntries.scrollHeight;

					// Trigger success state after 600ms simulation delay
					setTimeout(() => {
						entry.className =
							"text-[9px] text-neutral-300 font-mono border-l-2 border-emerald-500 pl-1.5 py-0.5";
						entry.innerHTML = `[${timeStr}] TX_${txId}: <span class="text-emerald-500">✓</span> POST_INTAKE_OK | SYNC: SUCCESS`;

						sandboxStatus.textContent = "ACTIVE";
						sandboxPulse.className =
							"h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse";
					}, 600);
				}

				// 7. NEW SPIN LOGIC: Committing and recalling pins from memory registry
				saveBtn.addEventListener("click", () => {
					const lat = parseFloat(latInput.value);
					const lng = parseFloat(lngInput.value);

					if (
						isNaN(lat) ||
						(!isNaN(lat) &&
							(lat < -90 || lat > 90 || lng < -180 || lng > 180))
					)
						return;

					const locationNode = { id: Date.now(), lat, lng };
					savedRegistry.push(locationNode);

					// Remove "Empty" notice upon first database commit
					if (emptyMsg) emptyMsg.remove();

					// Append clickable text node to interface list
					const li = document.createElement("li");
					li.className =
						"flex justify-between items-center bg-neutral-900/80 border border-neutral-800/60 rounded px-2 py-1 text-neutral-400 font-mono text-[11px] hover:border-neutral-700 hover:text-neutral-200 cursor-pointer transition-all";
					li.innerHTML = `<span>LOC_${locationNode.id.toString().slice(-4)} ➔ [${lat.toFixed(4)}, ${lng.toFixed(4)}]</span>`;

					// Clicking the list item recalls coordinate parameters and centers map
					li.addEventListener("click", () => {
						updateSystemPosition(
							locationNode.lat,
							locationNode.lng,
						);
					});

					savedList.appendChild(li);
					triggerSandboxLog(lat, lng);
				});

				// Theme Toggle Logic
				const themeToggleBtns = document.querySelectorAll(".theme-toggle-btn");

				function updateThemeUI(isLight) {
					themeToggleBtns.forEach(btn => {
						const textSpan = btn.querySelector("span");
						if (isLight) {
							document.documentElement.classList.add("light");
							btn.innerHTML = textSpan ? `<span>THEME: BEIGE_MODE</span><span id="theme-icon">☾</span>` : "☾";
						} else {
							document.documentElement.classList.remove("light");
							btn.innerHTML = textSpan ? `<span>THEME: DEFAULT (DARK)</span><span id="theme-icon">☼</span>` : "☼";
						}
					});
				}

				// Initialize UI state
				const isCurrentlyLight =
					document.documentElement.classList.contains("light");
				updateThemeUI(isCurrentlyLight);

				themeToggleBtns.forEach(btn => {
					btn.addEventListener("click", () => {
						const isLight =
							document.documentElement.classList.toggle("light");
						localStorage.setItem("theme", isLight ? "light" : "dark");
						updateThemeUI(isLight);
					});
				});

				// Mobile Menu Toggle Logic
				const menuToggle = document.getElementById("menu-toggle");
				const mobileMenu = document.getElementById("mobile-menu");
				const mobileNavLinks = document.querySelectorAll(".mobile-nav-link");

				if (menuToggle && mobileMenu) {
					menuToggle.addEventListener("click", () => {
						const isOpen = menuToggle.classList.toggle("open");
						if (isOpen) {
							mobileMenu.classList.remove("-translate-y-full", "opacity-0", "pointer-events-none");
						} else {
							mobileMenu.classList.add("-translate-y-full", "opacity-0", "pointer-events-none");
						}
					});

					mobileNavLinks.forEach(link => {
						link.addEventListener("click", () => {
							menuToggle.classList.remove("open");
							mobileMenu.classList.add("-translate-y-full", "opacity-0", "pointer-events-none");
						});
					});
				}

				// Walkthrough Console Toggle
				const engineCard = document.getElementById(
					"engine-metrics-card",
				);
				const walkthroughConsole = document.getElementById(
					"walkthrough-console",
				);

				if (engineCard && walkthroughConsole) {
					engineCard.addEventListener("click", () => {
						walkthroughConsole.classList.toggle("hidden");
						walkthroughConsole.classList.toggle("animate-fade-in");
						console.log(
							"System Walkthrough Initialized: Astro + Vanilla JS Target ESNEXT.",
						);
					});

					// Prevent clicks inside the walkthrough console from closing it
					walkthroughConsole.addEventListener("click", (e) => {
						e.stopPropagation();
					});
				}

				// Active Stream Controller Script for Telemetry Log
				const logContainer = document.getElementById(
					"telemetry-log-stream",
				);
				const telemetryWidget =
					document.getElementById("telemetry-widget");
				if (logContainer) {
					// Ordered sequence logs mapping back to your structural ecosystem
					const bootLogs = [
						{
							type: "OK",
							text: "Executed technical architecture demonstration for DOST ITSM rollout.",
						},
						{
							type: "SYS",
							text: "Data routing rules and payload integrity verified via PHP Laravel.",
						},
						{
							type: "OK",
							text: "Architected local-only task tracking application for high-speed, frictionless input.",
						},
						{
							type: "OK",
							text: "Integrated WebGL rendering engine for interactive 3D spatial visualization.",
						},
						{
							type: "INFO",
							text: "Listening for incoming integration webhook probes...",
						},
						{
							type: "READY",
							text: "System completely idle. Awaiting client interaction.█",
						},
					];

					logContainer.innerHTML = ""; // Wipe initial server placeholder
					let currentLine = 0;

					function renderNextLogLine() {
						if (currentLine >= bootLogs.length) return;

						const lineData = bootLogs[currentLine];
						const row = document.createElement("div");

						// Syntax highlight styling based on status type
						let badge = `<span class="text-neutral-500">[SYS]</span>`;
						if (lineData.type === "OK")
							badge = `<span class="text-emerald-400">[ OK ]</span>`;
						if (lineData.type === "SPEC")
							badge = `<span class="text-amber-400">[SPEC]</span>`;
						if (lineData.type === "INFO")
							badge = `<span class="text-sky-400">[INFO]</span>`;
						if (lineData.type === "READY")
							badge = `<span class="text-emerald-400 animate-pulse">[RDY]</span>`;

						row.innerHTML = `${badge} <span class="text-neutral-300">${lineData.text}</span>`;
						row.className =
							"opacity-0 transform translate-y-1 transition-all duration-300 ease-out";

						logContainer.appendChild(row);

						// Force repaint to trigger animation fade-in effect smoothly
						setTimeout(() => {
							row.classList.remove("opacity-0", "translate-y-1");
						}, 10);

						currentLine++;
						// Natural stepping delay simulating network handshakes
						setTimeout(
							renderNextLogLine,
							Math.random() * 400 + 300,
						);
					}

					// Initialize telemetry script playback
					setTimeout(renderNextLogLine, 400);
				}

				if (telemetryWidget) {
					// Prevent clicks inside the telemetry log container from toggling the walkthrough console
					telemetryWidget.addEventListener("click", (e) => {
						e.stopPropagation();
					});
				}

				// --- INTERACTIVE PROJECT SPECIFICATION VIEW CONTROLLER ---
				const projectCards = document.querySelectorAll(".project-card");

				projectCards.forEach((card) => {
					const toggleButtons = card.querySelectorAll(".toggle-btn");
					const panels = card.querySelectorAll("[data-panel]");

					toggleButtons.forEach((btn) => {
						btn.addEventListener("click", () => {
							const targetState =
								btn.getAttribute("data-trigger");

							// 1. Reset button active states inside this explicit card container
							toggleButtons.forEach((b) => {
								b.classList.remove(
									"bg-neutral-200",
									"text-neutral-950",
									"border-neutral-200",
								);
								b.classList.add(
									"text-neutral-500",
									"border-neutral-800",
								);
							});

							// Highlight the clicked interactive option toggle
							btn.classList.add(
								"bg-neutral-200",
								"text-neutral-950",
								"border-neutral-200",
							);
							btn.classList.remove(
								"text-neutral-500",
								"border-neutral-800",
							);

							// 2. Cross-fade panel visibility layouts
							panels.forEach((panel) => {
								if (
									panel.getAttribute("data-panel") ===
									targetState
								) {
									panel.classList.remove("hidden");
									panel.classList.add("animate-fade-in");
								} else {
									panel.classList.add("hidden");
									panel.classList.remove("animate-fade-in");
								}
							});
						});
					});
				});

				// --- DYNAMIC CLIENT-SIDE 3D VIEWPORT ENGINE ---
				const bootBtn = document.querySelector("#boot-canvas-btn");
				const canvasElement = document.querySelector("#jewelry-canvas");
				const statusText = document.querySelector("#canvas-status");
				const consoleMsg = document.querySelector(
					"#canvas-console-msg",
				);
				const modelButtons =
					document.querySelectorAll(".model-select-btn");
				const expandBtn = document.querySelector("#toggle-expand-btn");
				const canvasContainer =
					document.querySelector("#canvas-container");

				let activeModel = "HeartRing.glb";
				let THREE, GLTFLoader, OrbitControls;
				let scene, camera, renderer, loader, controls, currentModel;
				let isBooted = false;

				// Handle model selector button clicks
				modelButtons.forEach((btn) => {
					btn.addEventListener("click", () => {
						const selectedModel = btn.getAttribute("data-model");
						if (activeModel === selectedModel) return;

						activeModel = selectedModel;

						// Reset styles for all model selector buttons
						modelButtons.forEach((b) => {
							b.className =
								"model-select-btn px-2 py-0.5 border border-neutral-800 text-neutral-500 hover:text-neutral-300 hover:border-neutral-700 rounded select-none cursor-pointer";
						});

						// Style the active button
						btn.className =
							"model-select-btn px-2 py-0.5 border border-neutral-200 bg-neutral-200 text-neutral-950 rounded select-none cursor-pointer";

						// If the engine is already booted, load the new model immediately
						if (isBooted) {
							loadModel(activeModel);
						}
					});
				});

				const modalElement = document.querySelector("#graphics-modal");
				const closeModalBtn =
					document.querySelector("#close-modal-btn");
				const modalPlaceholder = document.querySelector(
					"#modal-canvas-placeholder",
				);
				const inlineContainer =
					document.querySelector("#canvas-container");

				if (
					expandBtn &&
					modalElement &&
					closeModalBtn &&
					modalPlaceholder &&
					inlineContainer &&
					canvasElement
				) {
					expandBtn.addEventListener("click", () => {
						// Open fullscreen modal
						modalElement.classList.remove("hidden");
						// Force reflow
						modalElement.offsetHeight;
						modalElement.classList.add("opacity-100");

						// Move canvas to modal placeholder
						modalPlaceholder.appendChild(canvasElement);

						// Trigger resize to update camera aspect ratio and renderer size
						setTimeout(() => {
							window.dispatchEvent(new Event("resize"));
						}, 50);
					});

					const closeModal = () => {
						modalElement.classList.remove("opacity-100");
						setTimeout(() => {
							modalElement.classList.add("hidden");
							// Move canvas back to inline container
							inlineContainer.appendChild(canvasElement);
							// Trigger resize to fit inline container size
							window.dispatchEvent(new Event("resize"));
						}, 300);
					};

					closeModalBtn.addEventListener("click", closeModal);

					// Close modal on escape key
					window.addEventListener("keydown", (e) => {
						if (
							e.key === "Escape" &&
							!modalElement.classList.contains("hidden")
						) {
							closeModal();
						}
					});
				}

				async function loadModel(modelName) {
					statusText.innerText = "● COMPILING";
					statusText.className = "text-amber-500 animate-pulse";
					consoleMsg.innerText = `Establishing model stream for ${modelName}...`;

					// Unload the current model to free up resources
					if (currentModel) {
						scene.remove(currentModel);
						currentModel.traverse((node) => {
							if (node.isMesh) {
								node.geometry.dispose();
								if (Array.isArray(node.material)) {
									node.material.forEach((mat) =>
										mat.dispose(),
									);
								} else {
									node.material.dispose();
								}
							}
						});
						currentModel = null;
					}

					loader.load(
						`/assets/models/${modelName}`,
						(gltf) => {
							currentModel = gltf.scene;

							// DYNAMIC SCALING: Normalize sizes so nothing is too big or too small
							const box = new THREE.Box3().setFromObject(
								currentModel,
							);
							const size = box.getSize(new THREE.Vector3());
							const maxDim = Math.max(size.x, size.y, size.z);
							const targetSize = 1.8; // Normalized size in WebGL units
							const scale = targetSize / maxDim;
							currentModel.scale.set(scale, scale, scale);

							// Center the scaled geometry perfectly inside the camera's focus space
							box.setFromObject(currentModel);
							const center = box.getCenter(new THREE.Vector3());
							currentModel.position.sub(center);

							scene.add(currentModel);

							// Reset OrbitControls target to center of the new model
							if (controls) {
								controls.target.set(0, 0, 0);
							}

							// Update status readout to operational
							statusText.innerText = "● ACTIVE";
							statusText.className =
								"text-emerald-600 animate-pulse";
							consoleMsg.innerText = `Pipeline stable. Model ${modelName} responding at 60 FPS.`;
						},
						undefined,
						(error) => {
							console.error(error);
							statusText.innerText = "❌ ERROR";
							statusText.className = "text-red-500";
							consoleMsg.innerText =
								"Buffer stream interrupted. Check asset resolution rules.";
						},
					);
				}

				if (bootBtn && canvasElement) {
					bootBtn.addEventListener("click", async () => {
						// 1. Update UI to compilation mode
						bootBtn.classList.add("hidden");
						canvasElement.classList.remove("hidden");
						if (expandBtn) expandBtn.classList.remove("hidden"); // Reveal expand button
						statusText.innerText = "● COMPILING";
						statusText.className = "text-amber-500 animate-pulse";
						consoleMsg.innerText =
							"Downloading model buffers & establishing WebGL context...";

						try {
							// 2. Dynamically import Three.js, GLTFLoader and OrbitControls over CDN using importmap
							THREE = await import("three");
							const loaderMod =
								await import("https://cdn.jsdelivr.net/npm/three@0.128.0/examples/jsm/loaders/GLTFLoader.js");
							GLTFLoader = loaderMod.GLTFLoader;

							const controlsMod =
								await import("https://cdn.jsdelivr.net/npm/three@0.128.0/examples/jsm/controls/OrbitControls.js");
							OrbitControls = controlsMod.OrbitControls;

							// 3. Initialize explicit rendering bounds
							const width =
								canvasElement.parentElement.clientWidth;
							const height =
								canvasElement.parentElement.clientHeight;

							scene = new THREE.Scene();

							camera = new THREE.PerspectiveCamera(
								45,
								width / height,
								0.1,
								100,
							);
							camera.position.set(0, 0, 3.5);

							renderer = new THREE.WebGLRenderer({
								canvas: canvasElement,
								antialias: true,
								alpha: true,
							});
							renderer.setSize(width, height);
							renderer.setPixelRatio(
								Math.min(window.devicePixelRatio, 2),
							);

							// PHYSICALLY CORRECT LIGHTING & COLOR SPACE SETUP (Fixes washed out/black textures)
							renderer.outputEncoding = THREE.sRGBEncoding;
							renderer.physicallyCorrectLights = true;
							renderer.toneMapping = THREE.ACESFilmicToneMapping;
							renderer.toneMappingExposure = 1.15;

							// 4. Attach system ambient, hemisphere, and key/fill directional lights
							const ambientLight = new THREE.AmbientLight(
								0xffffff,
								0.55,
							);
							scene.add(ambientLight);

							const hemiLight = new THREE.HemisphereLight(
								0xffffff,
								0x333333,
								1.25,
							);
							scene.add(hemiLight);

							// Key light
							const keyLight = new THREE.DirectionalLight(
								0xffffff,
								1.8,
							);
							keyLight.position.set(5, 8, 5);
							scene.add(keyLight);

							// Fill light
							const fillLight = new THREE.DirectionalLight(
								0xffffff,
								1.0,
							);
							fillLight.position.set(-5, 2, 2);
							scene.add(fillLight);

							// Rim light for edge definitions
							const rimLight = new THREE.DirectionalLight(
								0xffffff,
								1.2,
							);
							rimLight.position.set(0, 4, -5);
							scene.add(rimLight);

							// GENERATE DYNAMIC PMREM ENVIRONMENT REFLECTIONS (Ensures metals reflect beautifully instead of looking black)
							const pmremGenerator = new THREE.PMREMGenerator(
								renderer,
							);
							pmremGenerator.compileEquirectangularShader();

							const canvas = document.createElement("canvas");
							canvas.width = 64;
							canvas.height = 32;
							const ctx = canvas.getContext("2d");
							const grad = ctx.createLinearGradient(
								0,
								0,
								0,
								canvas.height,
							);
							grad.addColorStop(0, "#ffffff"); // bright sky reflection
							grad.addColorStop(0.5, "#999999"); // horizon
							grad.addColorStop(1, "#111111"); // dark ground
							ctx.fillStyle = grad;
							ctx.fillRect(0, 0, canvas.width, canvas.height);

							const tempTexture = new THREE.CanvasTexture(canvas);
							tempTexture.mapping =
								THREE.EquirectangularReflectionMapping;
							const envMap =
								pmremGenerator.fromEquirectangular(
									tempTexture,
								).texture;
							scene.environment = envMap;

							tempTexture.dispose();
							pmremGenerator.dispose();

							// 5. Initialize the Loader and OrbitControls
							loader = new GLTFLoader();
							isBooted = true;

							controls = new OrbitControls(
								camera,
								renderer.domElement,
							);
							controls.enableDamping = true;
							controls.dampingFactor = 0.05;
							controls.enableZoom = true;
							controls.autoRotate = true;
							controls.autoRotateSpeed = 1.0;

							await loadModel(activeModel);

							// 6. Interactive Render Loop
							function animate() {
								requestAnimationFrame(animate);

								if (controls) {
									controls.update();
								}

								renderer.render(scene, camera);
							}
							animate();

							// Handle structural viewport adjustments gracefully
							window.addEventListener("resize", () => {
								const w =
									canvasElement.parentElement.clientWidth;
								const h =
									canvasElement.parentElement.clientHeight;
								camera.aspect = w / h;
								camera.updateProjectionMatrix();
								renderer.setSize(w, h);
							});
						} catch (err) {
							console.error(
								"WebGL Engine boot sequence failure:",
								err,
							);
							statusText.innerText = "❌ ERROR";
							statusText.className = "text-red-500";
							consoleMsg.innerText =
								"WebGL Engine boot sequence failure.";
						}
					});
				}
			});
		</script>

		<!-- Fullscreen 3D Viewport Lightbox Modal -->
		<div
			id="graphics-modal"
			class="fixed inset-0 z-[100] hidden bg-neutral-950/80 backdrop-blur-md flex items-center justify-center p-4 sm:p-6 md:p-10 opacity-0 transition-opacity duration-300"
		>
			<div
				class="relative w-full max-w-5xl h-[85vh] bg-neutral-900/90 border border-neutral-800 rounded-2xl p-6 flex flex-col justify-between shadow-2xl font-mono text-[10px] text-neutral-400"
			>
				<!-- Modal Header -->
				<div
					class="flex items-center justify-between border-b border-neutral-800 pb-3 mb-4 text-xs"
				>
					<div class="flex items-center gap-2">
						<span class="text-emerald-500 animate-pulse">●</span>
						<span class="text-neutral-300 font-bold"
							>// SPATIAL_ECOMMERCE_VIEWPORT (IMMERSE_MODE)</span
						>
					</div>
					<button
						id="close-modal-btn"
						class="border border-neutral-800 hover:border-neutral-600 text-neutral-400 hover:text-neutral-200 px-3 py-1 rounded cursor-pointer transition-all select-none"
						>[ CLOSE_VIEW ]</button
					>
				</div>

				<!-- Modal Canvas Body -->
				<div
					id="modal-canvas-placeholder"
					class="flex-1 w-full relative rounded-xl border border-dashed border-neutral-800 bg-neutral-950/80 flex items-center justify-center overflow-hidden shadow-inner"
				>
					<!-- The canvas will be appended here dynamically on expand -->
				</div>

				<!-- Modal Footer Info -->
				<div
					class="flex flex-col sm:flex-row sm:items-center justify-between border-t border-neutral-800 pt-3 mt-4 gap-2 text-[9px] text-neutral-500"
				>
					<span
						>CONTROL: LEFT_DRAG = ORBIT | SCROLL = ZOOM | RIGHT_DRAG
						= PAN</span
					>
					<span id="modal-console-msg" class="italic"
						>Viewport scale optimized to full density.</span
					>
				</div>
			</div>
		</div>
	</body>
</html>
