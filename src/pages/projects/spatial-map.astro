				</div>

				<!-- RIGHT COLUMN: Fills that plain empty whitespace void (Spans 4 of 12 columns) -->
				<aside
					id="engine-metrics-card"
					class="lg:col-span-4 border border-neutral-800 bg-neutral-900/10 rounded-xl p-5 font-mono text-[11px] flex flex-col gap-4 rigid-card lg:sticky lg:top-16 backdrop-blur-sm cursor-pointer select-none system-card"
				>
					<div
						class="flex items-center justify-between border-b border-neutral-800/60 pb-2 text-neutral-400"
					>
						<span>// ENGINE_METRICS</span>
						<span class="h-2 w-2 engine-status-active"></span>
					</div>

					<div class="flex flex-col gap-2">
						<div class="flex justify-between text-neutral-500">
							<span>ENVIRONMENT:</span><span
								class="text-neutral-300">PRODUCTION</span
							>
						</div>
						<div class="flex justify-between text-neutral-500">
							<span>STACK:</span><span class="text-neutral-300"
								>ASTRO_VANILLA_JS</span
							>
						</div>
						<div class="flex justify-between text-neutral-500">
							<span>COMPILER_TARGET:</span><span
								class="text-neutral-300">ESNEXT</span
							>
						</div>
					</div>

					<hr class="border-neutral-800/60" />

					<div class="flex flex-col gap-1">
						<span
							class="text-neutral-500 font-bold uppercase text-[9px] tracking-wider"
							>// PLATFORM SOLUTIONS SPEC</span
						>
						<div
							class="bg-neutral-950/40 border border-neutral-800/80 rounded px-2.5 py-2 mt-1 flex flex-col gap-1.5 text-neutral-400"
						>
							<div class="flex items-center gap-2">
								<span class="text-emerald-500">✓</span>
								<span
									>Freshservice Advanced Product Certification</span
								>
							</div>
						</div>
					</div>

					<div
						id="walkthrough-console"
						class="hidden border-t border-neutral-800/60 pt-4 mt-2 flex flex-col gap-3"
					>
						<span
							class="text-neutral-500 font-bold uppercase text-[9px] tracking-wider"
							>// SYSTEM_WALKTHROUGH</span
						>
						<div
							class="bg-neutral-950 border border-neutral-900 p-3 rounded font-mono text-[10px] flex flex-col gap-2.5 leading-relaxed text-neutral-400"
						>
							<div class="flex items-start gap-1.5">
								<span class="text-emerald-500 font-bold"
									>01.</span
								>
								<div>
									<span class="text-neutral-200 font-bold"
										>Astro Core:</span
									>
									Pre-renders pages to static HTML, shipping zero
									client JS.
								</div>
							</div>
							<div class="flex items-start gap-1.5">
								<span class="text-emerald-500 font-bold"
									>02.</span
								>
								<div>
									<span class="text-neutral-200 font-bold"
										>Tailwind compilation:</span
									>
									Utility classes bundle to minimal static stylesheet.
								</div>
							</div>
							<div class="flex items-start gap-1.5">
								<span class="text-emerald-500 font-bold"
									>03.</span
								>
								<div>
									<span class="text-neutral-200 font-bold"
										>Vanilla JS State:</span
									>
									Coordinates and maps load and bind on element
									initialization.
								</div>
							</div>
							<div
								class="text-[9px] text-neutral-500 border-t border-neutral-900/60 pt-1.5 mt-1"
							>
								Target: ESNEXT | Mode: Static Build
							</div>
						</div>
					</div>
				</aside>
			</main>
		</div>

		<script is:inline>
			window.addEventListener("DOMContentLoaded", () => {
				// 1. Core Portfolio Theme Toggle Logic
				const themeToggleBtns =
					document.querySelectorAll(".theme-toggle-btn");

				function updateThemeUI(isLight) {
					themeToggleBtns.forEach((btn) => {
						const textSpan = btn.querySelector("span");
						if (isLight) {
							document.documentElement.classList.add("light");
							btn.innerHTML = textSpan
								? `<span>THEME: BEIGE_MODE</span><span id="theme-icon">☾</span>`
								: "☾";
						} else {
							document.documentElement.classList.remove("light");
							btn.innerHTML = textSpan
								? `<span>THEME: DEFAULT (DARK)</span><span id="theme-icon">☼</span>`
								: "☼";
						}
					});
				}

				const isCurrentlyLight =
					document.documentElement.classList.contains("light");
				updateThemeUI(isCurrentlyLight);

				themeToggleBtns.forEach((btn) => {
					btn.addEventListener("click", () => {
						const isLight =
							document.documentElement.classList.toggle("light");
						localStorage.setItem(
							"theme",
							isLight ? "light" : "dark",
						);
						updateThemeUI(isLight);
					});
				});

				// Mobile Menu Toggle Logic
				const menuToggle = document.getElementById("menu-toggle");
				const mobileMenu = document.getElementById("mobile-menu");
				const mobileNavLinks =
					document.querySelectorAll(".mobile-nav-link");

				if (menuToggle && mobileMenu) {
					menuToggle.addEventListener("click", () => {
						const isOpen = menuToggle.classList.toggle("open");
						if (isOpen) {
							mobileMenu.classList.remove(
								"-translate-y-full",
								"opacity-0",
								"pointer-events-none",
							);
						} else {
							mobileMenu.classList.add(
								"-translate-y-full",
								"opacity-0",
								"pointer-events-none",
							);
						}
					});

					mobileNavLinks.forEach((link) => {
						link.addEventListener("click", () => {
							menuToggle.classList.remove("open");
							mobileMenu.classList.add(
								"-translate-y-full",
								"opacity-0",
								"pointer-events-none",
							);
						});
					});
				}

				// 2. Interactive Workspace Sandbox State Engine
				let sandboxState = {
					location_context: "STREET_SITUATION",
					primary_beneficiary: "Gerard Dominic",
					coordinates: { lat: 14.6542, lng: 121.0496 },
					dependents: [],
				};

				let dependentIdCounter = 0;
				let sandboxMap = null;
				let currentMarker = null;

				const contextToggle =
					document.getElementById("sim-context-toggle");
				const nameInput = document.getElementById("sim-input-name");
				const latLabel = document.getElementById("sim-lat");
				const lngLabel = document.getElementById("sim-lng");
				const dependentsWrapper = document.getElementById(
					"sim-dependents-wrapper",
				);
				const addMemberBtn =
					document.getElementById("sim-add-member-btn");
				const payloadDisplay =
					document.getElementById("sim-payload-json");

				function updatePayloadView() {
					payloadDisplay.textContent = JSON.stringify(
						sandboxState,
						null,
						2,
					);
				}

				// Synchronize Toggle Changes
				contextToggle.addEventListener("click", () => {
					if (sandboxState.location_context === "STREET_SITUATION") {
						sandboxState.location_context = "STRUCTURED_SHELTER";
						contextToggle.textContent = "STRUCTURED_SHELTER";
						contextToggle.className =
							"px-2 py-0.5 text-[10px] font-mono font-bold rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 hover:bg-emerald-500/20 transition-all select-none cursor-pointer";
					} else {
						sandboxState.location_context = "STREET_SITUATION";
						contextToggle.textContent = "STREET_SITUATION";
						contextToggle.className =
							"px-2 py-0.5 text-[10px] font-mono font-bold rounded bg-amber-500/10 text-amber-400 border border-amber-500/20 hover:bg-amber-500/20 transition-all select-none cursor-pointer";
					}
					updatePayloadView();
				});

				// Sync Primary Name Input
				nameInput.addEventListener("input", (e) => {
					sandboxState.primary_beneficiary = e.target.value;
					updatePayloadView();
				});

				// Instantiate Dynamic Sub-form Generator (Repeater Engine)
				function createDependentSubform() {
					dependentIdCounter++;
					const id = dependentIdCounter;

					// Push fresh node registry entry into memory array
					const defaultNode = {
						id: id,
						name: "Dependent Node",
						relationship: "Child",
					};
					sandboxState.dependents.push(defaultNode);

					// Inject clean HTML template block directly into wrapper container
					const subform = document.createElement("div");
					subform.id = `dep-node-${id}`;
					subform.className =
						"grid grid-cols-12 gap-2 bg-neutral-900 border border-neutral-800/60 rounded-lg p-2.5 items-center animation-fade-in";
					subform.innerHTML = `
						<div class="col-span-6 flex flex-col gap-0.5">
							<input type="text" placeholder="Dependent Name" value="Dependent Node" class="dep-name bg-neutral-950 border border-neutral-800 text-neutral-300 rounded px-2 py-1 font-mono text-[11px] focus:outline-none focus:border-neutral-700" />
						</div>
						<div class="col-span-4 flex flex-col gap-0.5">
							<select class="dep-relation bg-neutral-950 border border-neutral-800 text-neutral-400 rounded px-1.5 py-1 font-mono text-[10px] focus:outline-none">
								<option value="Child" selected>Child</option>
								<option value="Spouse">Spouse</option>
								<option value="Sibling">Sibling</option>
								<option value="Other">Other</option>
							</select>
						</div>
						<div class="col-span-2 flex justify-end">
							<button class="dep-delete-btn font-mono text-[10px] text-rose-500/70 hover:text-rose-400 bg-rose-500/5 border border-rose-500/10 px-2 py-1 rounded hover:bg-rose-500/10 transition-all cursor-pointer">DEL</button>
						</div>
					`;

					dependentsWrapper.appendChild(subform);
					updatePayloadView();

					// Event Listeners for inner subform mutation
					const nameField = subform.querySelector(".dep-name");
					const relationField =
						subform.querySelector(".dep-relation");
					const deleteBtn = subform.querySelector(".dep-delete-btn");

					nameField.addEventListener("input", (e) => {
						const match = sandboxState.dependents.find(
							(d) => d.id === id,
						);
						if (match) match.name = e.target.value;
						updatePayloadView();
					});

					relationField.addEventListener("change", (e) => {
						const match = sandboxState.dependents.find(
							(d) => d.id === id,
						);
						if (match) match.relationship = e.target.value;
						updatePayloadView();
					});

					deleteBtn.addEventListener("click", () => {
						sandboxState.dependents =
							sandboxState.dependents.filter((d) => d.id !== id);
						subform.remove();
						updatePayloadView();
					});
				}

				addMemberBtn.addEventListener("click", createDependentSubform);

				// Initialize Leaflet Interactive Canvas Workspace
				function initSandboxMapEngine() {
					if (sandboxMap) return; // Prevent double mounts

					// Mount base coordinates targeting an operational sector
					sandboxMap = L.map("sim-map-canvas", {
						center: [14.6542, 121.0496],
						zoom: 13,
						zoomControl: false,
					});

					// Load standard colorful OpenStreetMap tiles
					L.tileLayer(
						"https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
						{
							attribution:
								'&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank">OpenStreetMap</a> contributors',
						},
					).addTo(sandboxMap);

					// Set Initial Pin configuration
					currentMarker = L.marker([14.6542, 121.0496]).addTo(
						sandboxMap,
					);

					// Coordinate Capture Vector Stream Listener
					sandboxMap.on("click", (event) => {
						const { lat, lng } = event.latlng;

						// Lock down floating system decimals to a clean 6-digit precision standard
						const lockedLat = parseFloat(lat.toFixed(6));
						const lockedLng = parseFloat(lng.toFixed(6));

						// Relocate marker target visual coordinates
						currentMarker.setLatLng([lockedLat, lockedLng]);
						sandboxMap.panTo([lockedLat, lockedLng]);

						// Mutate System Memory State and update the UI View
						sandboxState.coordinates.lat = lockedLat;
						sandboxState.coordinates.lng = lockedLng;

						latLabel.textContent = lockedLat;
						lngLabel.textContent = lockedLng;

						updatePayloadView();
					});
				}

				// Execute core payload visualization stream on initialization
				updatePayloadView();

				// Standard initialization loop execution
				setTimeout(() => {
					initSandboxMapEngine();
				}, 100);

				// 2.5 Submit Action & Validation Guardrails
				const submitBtn = document.getElementById("sim-submit-btn");
				const apiConsole = document.getElementById("sim-api-console");

				submitBtn.addEventListener("click", () => {
					const lat = sandboxState.coordinates.lat;
					const lng = sandboxState.coordinates.lng;
					const name = sandboxState.primary_beneficiary.trim();

					apiConsole.innerHTML = "";

					if (!name) {
						apiConsole.innerHTML = `<span class="text-rose-500 font-bold">[VALIDATION_FAILURE]</span> <span class="text-rose-400">Primary beneficiary field is empty. Ingestion aborted.</span>`;
						return;
					}

					// Philippine geographical limits
					const minLat = 4.0;
					const maxLat = 21.0;
					const minLng = 116.0;
					const maxLng = 127.0;

					if (
						lat < minLat ||
						lat > maxLat ||
						lng < minLng ||
						lng > maxLng
					) {
						apiConsole.innerHTML = `<span class="text-rose-500 font-bold">[VALIDATION_FAILURE]</span> <span class="text-rose-400">Coordinates [${lat}, ${lng}] are outside the administrative borders of the Philippines (${minLat}° to ${maxLat}° N, ${minLng}° to ${maxLng}° E). Ingestion aborted.</span>`;
					} else {
						apiConsole.innerHTML = `<span class="text-emerald-500 font-bold">[API_SUCCESS]</span> <span class="text-emerald-400">Ingestion successful! Staged schema committed to dormant database columns. Staging 1 primary node ("${name}") and ${sandboxState.dependents.length} dependent nodes.</span>`;
					}
				});

				// 3. Intersection Observer for Dynamic Breakout Layout
				const simCard = document.getElementById(
					"interactive-simulation-card",
				);
				const statusPulse = document.getElementById("sim-status-pulse");
				const statusText = document.getElementById("sim-status-text");

				const observer = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (entry.isIntersecting) {
								simCard.classList.add("expanded");
								statusPulse.className =
									"h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse transition-all duration-700";
								statusText.className =
									"text-[10px] font-mono text-emerald-400 uppercase tracking-widest transition-all duration-700";
								statusText.textContent =
									"// Sandbox Environment: Active Workspace";
								let count = 0;
								const interval = setInterval(() => {
									if (sandboxMap) {
										sandboxMap.invalidateSize();
									}
									count++;
									if (count > 35) clearInterval(interval);
								}, 20);
							} else {
								simCard.classList.remove("expanded");
								statusPulse.className =
									"h-1.5 w-1.5 rounded-full bg-neutral-700 transition-all duration-700";
								statusText.className =
									"text-[10px] font-mono text-neutral-500 uppercase tracking-widest transition-all duration-700";
								statusText.textContent =
									"// Sandbox Environment: Standby";
								let count = 0;
								const interval = setInterval(() => {
									if (sandboxMap) {
										sandboxMap.invalidateSize();
									}
									count++;
									if (count > 35) clearInterval(interval);
								}, 20);
							}
						});
					},
					{
						threshold: 0.15,
					},
				);
				observer.observe(simCard);

				// Walkthrough Console Toggle
				const engineCard = document.getElementById(
					"engine-metrics-card",
				);
				const walkthroughConsole = document.getElementById(
					"walkthrough-console",
				);

				if (engineCard && walkthroughConsole) {
					engineCard.addEventListener("click", () => {
						walkthroughConsole.classList.toggle("hidden");
						walkthroughConsole.classList.toggle("animate-fade-in");
						console.log(
							"System Walkthrough Initialized: Astro + Vanilla JS Target ESNEXT.",
						);
					});

					// Prevent clicks inside the walkthrough console from closing it
					walkthroughConsole.addEventListener("click", (e) => {
						e.stopPropagation();
					});
				}
			});
		</script>
	</body>
</html>
