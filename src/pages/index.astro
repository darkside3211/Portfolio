---
// src/pages/index.astro
import "../styles/global.css";
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Gerard Baldo | System-First Engineer</title>
		<script type="importmap">
			{
				"imports": {
					"three": "https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.module.js"
				}
			}
		</script>
		<script is:inline>
			(function () {
				const savedTheme = localStorage.getItem("theme");
				if (savedTheme === "light") {
					document.documentElement.classList.add("light");
				} else {
					document.documentElement.classList.remove("light");
				}
			})();
		</script>
		<style>
			/* 1. Dot-Matrix Grid Layer Canvas mapping */
			body {
				background-image: radial-gradient(
					rgba(63, 63, 70, 0.25) 1px,
					transparent 1px
				);
				background-size: 20px 20px;
			}
			:global(.light) body {
				background-image: radial-gradient(
					rgba(181, 173, 148, 0.4) 1px,
					transparent 1px
				);
			}

			/* 2. Rigid Brutalist Shadow Mappings */
			.rigid-card {
				box-shadow: 4px 4px 0px 0px rgba(0, 0, 0, 0.5);
				transition:
					transform 0.2s cubic-bezier(0.16, 1, 0.3, 1),
					box-shadow 0.2s cubic-bezier(0.16, 1, 0.3, 1);
			}
			.rigid-card:hover {
				transform: translate(-1px, -1px);
				box-shadow: 5px 5px 0px 0px rgba(0, 0, 0, 0.6);
			}
			:global(.light) .rigid-card {
				box-shadow: 4px 4px 0px 0px rgba(42, 40, 34, 0.08);
			}
			:global(.light) .rigid-card:hover {
				box-shadow: 5px 5px 0px 0px rgba(42, 40, 34, 0.12);
			}

			/* 3. Smooth Collapsible Accordion Animations */
			@keyframes accordionSlide {
				from {
					opacity: 0;
					transform: translateY(-6px);
				}
				to {
					opacity: 1;
					transform: translateY(0);
				}
			}
			details[open] > *:not(summary) {
				animation: accordionSlide 0.25s cubic-bezier(0.16, 1, 0.3, 1)
					forwards;
			}
		</style>
	</head>
	<body
		class="bg-neutral-950 text-neutral-100 font-sans selection:bg-neutral-800 antialiased"
	>
		<div class="flex min-h-screen">
			<!-- Mobile Header -->
			<header
				class="fixed top-0 left-0 right-0 h-16 border-b border-neutral-800 bg-neutral-950/90 backdrop-blur-md px-4 flex items-center justify-between z-50 lg:hidden"
			>
				<div class="flex items-center gap-3">
					<div
						class="h-9 w-9 rounded bg-neutral-900 border border-neutral-800 flex items-center justify-center text-xs font-bold tracking-tight text-neutral-300"
					>
						GB
					</div>
					<div>
						<h2 class="text-xs font-semibold text-neutral-200 tracking-tight">
							Gerard Baldo
						</h2>
						<p class="text-[9px] text-neutral-500 font-mono">
							System-First Engineer
						</p>
					</div>
				</div>
				<div class="flex items-center gap-2">
					<button
						class="theme-toggle-btn border border-neutral-800 bg-neutral-900/10 text-neutral-400 hover:text-neutral-200 transition-all rounded p-1.5 text-xs font-mono select-none cursor-pointer"
						aria-label="Toggle Theme"
					>
						☼
					</button>
					<button
						id="menu-toggle"
						class="border border-neutral-800 bg-neutral-900/10 text-neutral-400 hover:text-neutral-200 transition-all rounded p-1.5 text-xs font-mono select-none cursor-pointer"
						aria-label="Toggle Menu"
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="18"
							height="18"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
						>
							<line x1="4" y1="12" x2="20" y2="12" id="menu-line-1"></line>
							<line x1="4" y1="6" x2="20" y2="6" id="menu-line-2"></line>
							<line x1="4" y1="18" x2="20" y2="18" id="menu-line-3"></line>
						</svg>
					</button>
				</div>
			</header>

			<!-- Mobile Navigation Drawer -->
			<div
				id="mobile-menu"
				class="fixed inset-x-0 top-16 bg-neutral-950/95 border-b border-neutral-800 z-40 flex flex-col justify-between p-6 transition-all duration-300 ease-in-out -translate-y-full opacity-0 pointer-events-none lg:hidden"
			>
				<nav class="flex flex-col gap-4 text-sm mt-4">
					<a
						href="#readme"
						class="mobile-nav-link group flex items-center gap-2 text-neutral-400 hover:text-neutral-100 transition-colors py-1.5 font-medium font-mono text-xs tracking-wider"
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="13"
							height="13"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							class="text-neutral-600 group-hover:text-neutral-400 transition-colors"
							><path
								d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"
							></path><polyline points="14 2 14 8 20 8"
							></polyline></svg
						>
						01. README.TXT
					</a>
					<a
						href="#manifesto"
						class="mobile-nav-link group flex items-center gap-2 text-neutral-400 hover:text-neutral-100 transition-colors py-1.5 font-medium font-mono text-xs tracking-wider"
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="13"
							height="13"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							class="text-neutral-600 group-hover:text-neutral-400 transition-colors"
							><path
								d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"
							></path><polyline points="14 2 14 8 20 8"
							></polyline></svg
						>
						02. MANIFESTO
					</a>
					<a
						href="#capabilities"
						class="mobile-nav-link group flex items-center gap-2 text-neutral-400 hover:text-neutral-100 transition-colors py-1.5 font-medium font-mono text-xs tracking-wider"
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="13"
							height="13"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							class="text-neutral-600 group-hover:text-neutral-400 transition-colors"
							><rect width="18" height="18" x="3" y="3" rx="2"
							></rect><path d="M9 3v18"></path><path
								d="M15 3v18"></path><path d="M3 9h18"
							></path><path d="M3 15h18"></path></svg
						>
						03. CAPABILITIES
					</a>
					<a
						href="#projects"
						class="mobile-nav-link group flex items-center gap-2 text-neutral-400 hover:text-neutral-100 transition-colors py-1.5 font-medium font-mono text-xs tracking-wider"
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="13"
							height="13"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							class="text-neutral-600 group-hover:text-neutral-400 transition-colors"
							><path d="m7.5 4.27 9 5.15"></path><path
								d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"
							></path><path d="m3.3 7 8.7 5 8.7-5"
							></path><path d="M12 22V12"></path></svg
						>
						04. PROJECTS_AREA
					</a>
				</nav>

				<div class="flex flex-col gap-4 mt-8 pt-4 border-t border-neutral-800">
					<div
						class="text-[10px] text-neutral-500 font-mono flex items-center gap-2 tracking-tight"
					>
						<span
							class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"
						></span>
						<span>ENVIRONMENT: ACTIVE</span>
					</div>
				</div>
			</div>

			<aside
				class="hidden lg:flex fixed top-0 left-0 h-screen w-64 border-r border-neutral-800 bg-neutral-950 p-6 flex-col justify-between z-50"
			>
				<div class="flex flex-col gap-8">
					<div class="flex flex-col gap-3">
						<div
							class="h-14 w-14 rounded-lg bg-neutral-900 border border-neutral-800 flex items-center justify-center text-lg font-bold tracking-tight text-neutral-300"
						>
							GB
						</div>
						<div>
							<h2
								class="font-semibold text-neutral-200 tracking-tight"
							>
								Gerard Baldo
							</h2>
							<p class="text-xs text-neutral-500 font-mono">
								System-First Engineer
							</p>
						</div>
					</div>

					<nav class="flex flex-col gap-2 text-sm">
						<a
							href="#readme"
							class="group flex items-center gap-2 text-neutral-400 hover:text-neutral-100 transition-colors py-1.5 font-medium font-mono text-xs tracking-wider"
						>
							<svg
								xmlns="http://www.w3.org/2000/svg"
								width="13"
								height="13"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								class="text-neutral-600 group-hover:text-neutral-400 transition-colors"
								><path
									d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"
								></path><polyline points="14 2 14 8 20 8"
								></polyline></svg
							>
							01. README.TXT
						</a>
						<a
							href="#manifesto"
							class="group flex items-center gap-2 text-neutral-400 hover:text-neutral-100 transition-colors py-1.5 font-medium font-mono text-xs tracking-wider"
						>
							<svg
								xmlns="http://www.w3.org/2000/svg"
								width="13"
								height="13"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								class="text-neutral-600 group-hover:text-neutral-400 transition-colors"
								><path
									d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"
								></path><polyline points="14 2 14 8 20 8"
								></polyline></svg
							>
							02. MANIFESTO
						</a>
						<a
							href="#capabilities"
							class="group flex items-center gap-2 text-neutral-400 hover:text-neutral-100 transition-colors py-1.5 font-medium font-mono text-xs tracking-wider"
						>
							<svg
								xmlns="http://www.w3.org/2000/svg"
								width="13"
								height="13"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								class="text-neutral-600 group-hover:text-neutral-400 transition-colors"
								><rect width="18" height="18" x="3" y="3" rx="2"
								></rect><path d="M9 3v18"></path><path
									d="M15 3v18"></path><path d="M3 9h18"
								></path><path d="M3 15h18"></path></svg
							>
							03. CAPABILITIES
						</a>
						<a
							href="#projects"
							class="group flex items-center gap-2 text-neutral-400 hover:text-neutral-100 transition-colors py-1.5 font-medium font-mono text-xs tracking-wider"
						>
							<svg
								xmlns="http://www.w3.org/2000/svg"
								width="13"
								height="13"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								class="text-neutral-600 group-hover:text-neutral-400 transition-colors"
								><path d="m7.5 4.27 9 5.15"></path><path
									d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"
								></path><path d="m3.3 7 8.7 5 8.7-5"
								></path><path d="M12 22V12"></path></svg
							>
							04. PROJECTS_AREA
						</a>
					</nav>
				</div>

				<div class="flex flex-col gap-4">
					<button
						id="theme-toggle"
						class="theme-toggle-btn flex items-center justify-between w-full border border-neutral-800 hover:border-neutral-700 bg-neutral-900/10 hover:bg-neutral-900/30 text-neutral-400 hover:text-neutral-200 transition-all rounded px-3 py-2 text-xs font-mono select-none cursor-pointer"
					>
						<span>THEME: DEFAULT (DARK)</span>
						<span id="theme-icon">☼</span>
					</button>

					<div
						class="text-[10px] text-neutral-500 font-mono flex items-center gap-2 tracking-tight"
					>
						<span
							class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"
						></span>
						<span>ENVIRONMENT: ACTIVE</span>
					</div>
				</div>
			</aside>

			<!-- UPDATED: Wider constraint and asymmetric grid layout -->
			<main
				class="flex-1 px-4 md:px-8 pt-24 pb-16 lg:ml-64 lg:px-16 lg:py-16 max-w-7xl grid grid-cols-1 lg:grid-cols-12 gap-8 items-start"
			>
				<!-- LEFT COLUMN: Content Column (Spans 8 of 12 columns) -->
				<div
					id="content-column"
					class="lg:col-span-8 flex flex-col gap-12 transition-all duration-500 ease-in-out"
				>
					<section
						id="readme"
						class="border border-neutral-800 [.light_&]:border-[#d2c9b1] bg-neutral-900/30 [.light_&]:bg-[#fdfaf2] rounded-xl p-6 sm:p-8 backdrop-blur-sm scroll-mt-16 relative flex flex-col sm:block overflow-hidden min-h-fit sm:min-h-[340px]"
					>
						<!-- Card Header Workspace Controllers -->
						<div
							class="flex items-center justify-between mb-5 border-b border-neutral-800/60 [.light_&]:border-b-[#d2c9b1]/50 pb-3 font-mono text-[10px] text-neutral-500 relative z-10"
						>
							<div class="flex items-center gap-1.5">
								<svg
									xmlns="http://www.w3.org/2000/svg"
									width="11"
									height="11"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2.5"
									stroke-linecap="round"
									stroke-linejoin="round"
									class="text-amber-500/90"
								>
									<path
										d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"
									></path>
									<polyline points="14 2 14 8 20 8"
									></polyline>
								</svg>
								<span class="terminal-path"
									>~/system_config/readme.txt</span
								>
							</div>
							<span>[AUTHOR_INFO]</span>
						</div>

						<!-- Left-Side Portrait Subsystem: Handles smooth spatial transformations -->
						<div
							id="bio-portrait-layer"
							class="hidden sm:block sm:absolute sm:left-0 sm:top-0 sm:h-full sm:w-[320px] pointer-events-none select-none z-0"
						>
							<img
								src="/profile.jpg"
								alt="Gerard Dominic Baldo"
								class="w-full h-full object-cover object-left-top brightness-[1.02] sm:rounded-none"
								id="bio-portrait-img"
							/>
							<!-- Color Stop Mask Engine -->
							<div
								id="bio-gradient-mask"
								class="absolute inset-0 sm:bg-gradient-to-r sm:from-transparent sm:via-transparent sm:via-65% sm:via-neutral-950/70 sm:via-80% sm:to-neutral-950 sm:to-95% [.light_&]:sm:from-transparent [.light_&]:sm:via-transparent [.light_&]:sm:via-65% [.light_&]:sm:via-[#fdfaf2]/80 [.light_&]:sm:via-80% [.light_&]:sm:to-[#fdfaf2] [.light_&]:sm:to-95%"
							>
							</div>
						</div>

						<!-- Content Layer: Transitions smoothly from restricted sidebar to a wide multi-column layout -->
						<div
							id="bio-content-layer"
							class="relative z-10 w-full sm:pl-[340px] flex flex-col h-full justify-between gap-6"
						>
							<!-- Profile Metadata -->
							<div class="flex flex-row items-center justify-between gap-4">
								<div class="flex-1">
									<h2
										class="text-2xl sm:text-3xl font-extrabold text-neutral-100 [.light_&]:text-[#2d2a24] tracking-tight"
									>
										Gerard Dominic Baldo
									</h2>
									<p
										class="text-sm text-amber-400 [.light_&]:text-[#b0873b] font-mono font-bold uppercase tracking-wider mt-1"
									>
										// System-First Engineer
									</p>
									<p
										class="text-xs text-neutral-500 [.light_&]:text-[#7c7565] font-mono mt-0.5"
									>
										Core Tech: Vue.js // Laravel // Astro
										Architecture
									</p>
								</div>

								<!-- Mobile-only premium avatar -->
								<div class="sm:hidden flex-shrink-0 relative select-none pointer-events-none">
									<div class="relative w-20 h-20 rounded-lg border border-neutral-800 [.light_&]:border-[#d2c9b1] bg-neutral-950/40 p-1">
										<div class="w-full h-full rounded-md overflow-hidden relative">
											<img
												src="/profile.jpg"
												alt="Gerard Dominic Baldo"
												class="w-full h-full object-cover object-left-top brightness-[1.02]"
											/>
										</div>
									</div>
									<!-- Micro-Status Indicator badge -->
									<span class="absolute -top-1 -right-1 flex h-2.5 w-2.5">
										<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
										<span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
									</span>
								</div>
							</div>

							<!-- Layout Divider -->
							<div
								id="bio-divider"
								class="w-full h-[1px] bg-neutral-800 [.light_&]:bg-[#d2c9b1]/50"
							>
							</div>

							<!-- Biography Processing Blocks -->
							<div
								id="bio-text-grid"
								class="space-y-4 text-sm leading-relaxed text-neutral-400 [.light_&]:text-[#4a453a] font-medium"
							>
								<p>
									Hey, I'm Gerard. You could call me a nerd or
									whatever, but I've just always had this
									thing for computers and figuring out how
									they actually work. When I build something,
									whether I'm using Vue.js, Laravel, or Astro,
									I care a lot about doing it the right way. I
									like making sure the foundation is solid
									instead of just hacking things together. I'm
									constantly turning problems over in my head,
									I'm that guy who steps away from the
									keyboard and suddenly figures out the
									solution to a bug out of nowhere. I just
									like doing things right, and doing them
									smart. Lately, I’ve also been doing some QA
									work, and honestly, intentionally trying to
									break other people's code is a blast. It
									feels a little evil, sure, but finding
									exactly where a system cracks is a massive
									perk—and it honestly just makes me build my
									own stuff even tighter.
								</p>
								<p
									class="text-xs text-neutral-500 [.light_&]:text-[#7c7565] font-mono italic"
								>
									~ When I need to step away and clear my
									head, I completely disconnect. I spend most
									of my free time taking walks, admiring the
									scenery, and just taking pictures wherever I
									happen to go.
								</p>
							</div>
						</div>
					</section>

					<section
						id="manifesto"
						class="border border-neutral-800 bg-neutral-900/30 rounded-xl p-8 backdrop-blur-sm scroll-mt-16 rigid-card system-card"
					>
						<div
							class="flex items-center justify-between border-b border-neutral-800/60 pb-3 mb-5 font-mono text-[10px] text-neutral-500"
						>
							<div class="flex items-center gap-1.5">
								<svg
									xmlns="http://www.w3.org/2000/svg"
									width="11"
									height="11"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2.5"
									stroke-linecap="round"
									stroke-linejoin="round"
									class="text-emerald-500"
									><polyline points="4 17 10 11 4 5"
									></polyline><line
										x1="12"
										y1="19"
										x2="20"
										y2="19"></line></svg
								>
								<span class="terminal-path"
									>~/manifesto/core_philosophy.md</span
								>
							</div>
							<span>[STABLE]</span>
						</div>
						<span
							class="text-[10px] font-mono text-neutral-500 uppercase tracking-widest"
							>// Core Philosophy</span
						>
						<h1
							class="text-2xl font-bold mt-2 mb-4 tracking-tight text-neutral-100"
						>
							System Over Syntax
						</h1>
						<!-- De-textified Spec Grid -->
						<div
							class="font-mono text-xs space-y-4 border-t border-neutral-800/60 pt-4 mt-6"
						>
							<p class="text-neutral-300 leading-relaxed text-sm">
								Frameworks evolve and syntax can be searched,
								but robust architecture is foundational. I build
								platforms prioritizing structural execution,
								data integrity, and cross-stack logic. My focus
								is on engineering scalable systems and adapting
								quickly to whatever tool best solves the
								problem.
