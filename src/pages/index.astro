---
// src/pages/index.astro
import "../styles/global.css";
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Gerard Baldo | System-First Engineer</title>
		<script type="importmap">
			{
				"imports": {
					"three": "https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.module.js"
				}
			}
		</script>
		<script is:inline>
			(function () {
				const savedTheme = localStorage.getItem("theme");
				if (savedTheme === "light") {
					document.documentElement.classList.add("light");
				} else {
					document.documentElement.classList.remove("light");
				}
			})();
		</script>
		<style>
			/* 1. Dot-Matrix Grid Layer Canvas mapping */
			body {
				background-image: radial-gradient(
					rgba(63, 63, 70, 0.25) 1px,
					transparent 1px
				);
				background-size: 20px 20px;
			}
			:global(.light) body {
				background-image: radial-gradient(
					rgba(181, 173, 148, 0.4) 1px,
					transparent 1px
				);
			}

			/* 2. Rigid Brutalist Shadow Mappings */
			.rigid-card {
				box-shadow: 4px 4px 0px 0px rgba(0, 0, 0, 0.5);
				transition:
					transform 0.2s cubic-bezier(0.16, 1, 0.3, 1),
					box-shadow 0.2s cubic-bezier(0.16, 1, 0.3, 1);
			}
			.rigid-card:hover {
				transform: translate(-1px, -1px);
				box-shadow: 5px 5px 0px 0px rgba(0, 0, 0, 0.6);
			}
			:global(.light) .rigid-card {
				box-shadow: 4px 4px 0px 0px rgba(42, 40, 34, 0.08);
			}
			:global(.light) .rigid-card:hover {
				box-shadow: 5px 5px 0px 0px rgba(42, 40, 34, 0.12);
			}

			/* 3. Smooth Collapsible Accordion Animations */
			@keyframes accordionSlide {
				from {
					opacity: 0;
					transform: translateY(-6px);
				}
				to {
					opacity: 1;
					transform: translateY(0);
				}
			}
			details[open] > *:not(summary) {
				animation: accordionSlide 0.25s cubic-bezier(0.16, 1, 0.3, 1)
					forwards;
			}
		</style>
	</head>
	<body
		class="bg-neutral-950 text-neutral-100 font-sans selection:bg-neutral-800 antialiased"
	>
		<div class="flex min-h-screen">
			<aside
				class="fixed top-0 left-0 h-screen w-64 border-r border-neutral-800 bg-neutral-950 p-6 flex flex-col justify-between z-50"
			>
				<div class="flex flex-col gap-8">
					<div class="flex flex-col gap-3">
						<div
							class="h-14 w-14 rounded-lg bg-neutral-900 border border-neutral-800 flex items-center justify-center text-lg font-bold tracking-tight text-neutral-300"
						>
							GB
						</div>
						<div>
							<h2
								class="font-semibold text-neutral-200 tracking-tight"
							>
								Gerard Baldo
							</h2>
							<p class="text-xs text-neutral-500 font-mono">
								System-First Engineer
							</p>
						</div>
					</div>

					<nav class="flex flex-col gap-2 text-sm">
						<a
							href="#manifesto"
							class="group flex items-center gap-2 text-neutral-400 hover:text-neutral-100 transition-colors py-1.5 font-medium font-mono text-xs tracking-wider"
						>
							<svg
								xmlns="http://www.w3.org/2000/svg"
								width="13"
								height="13"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								class="text-neutral-600 group-hover:text-neutral-400 transition-colors"
								><path
									d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"
								></path><polyline points="14 2 14 8 20 8"
								></polyline></svg
							>
							01. MANIFESTO
						</a>
						<a
							href="#capabilities"
							class="group flex items-center gap-2 text-neutral-400 hover:text-neutral-100 transition-colors py-1.5 font-medium font-mono text-xs tracking-wider"
						>
							<svg
								xmlns="http://www.w3.org/2000/svg"
								width="13"
								height="13"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								class="text-neutral-600 group-hover:text-neutral-400 transition-colors"
								><rect width="18" height="18" x="3" y="3" rx="2"
								></rect><path d="M9 3v18"></path><path
									d="M15 3v18"></path><path d="M3 9h18"
								></path><path d="M3 15h18"></path></svg
							>
							02. CAPABILITIES
						</a>
						<a
							href="#projects"
							class="group flex items-center gap-2 text-neutral-400 hover:text-neutral-100 transition-colors py-1.5 font-medium font-mono text-xs tracking-wider"
						>
							<svg
								xmlns="http://www.w3.org/2000/svg"
								width="13"
								height="13"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								class="text-neutral-600 group-hover:text-neutral-400 transition-colors"
								><path d="m7.5 4.27 9 5.15"></path><path
									d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"
								></path><path d="m3.3 7 8.7 5 8.7-5"
								></path><path d="M12 22V12"></path></svg
							>
							03. PROJECTS_AREA
						</a>
					</nav>
				</div>

				<div class="flex flex-col gap-4">
					<button
						id="theme-toggle"
						class="flex items-center justify-between w-full border border-neutral-800 hover:border-neutral-700 bg-neutral-900/10 hover:bg-neutral-900/30 text-neutral-400 hover:text-neutral-200 transition-all rounded px-3 py-2 text-xs font-mono select-none cursor-pointer"
					>
						<span>THEME: DEFAULT (DARK)</span>
						<span id="theme-icon">☼</span>
					</button>

					<div
						class="text-[10px] text-neutral-500 font-mono flex items-center gap-2 tracking-tight"
					>
						<span
							class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"
						></span>
						<span>ENVIRONMENT: ACTIVE</span>
					</div>
				</div>
			</aside>

			<!-- UPDATED: Wider constraint and asymmetric grid layout -->
			<main
				class="ml-64 flex-1 px-8 md:px-16 py-16 max-w-7xl grid grid-cols-1 lg:grid-cols-12 gap-8 items-start"
			>
				<!-- LEFT COLUMN: Content Column (Spans 8 of 12 columns) -->
				<div class="lg:col-span-8 flex flex-col gap-12">
					<section
						id="manifesto"
						class="border border-neutral-800 bg-neutral-900/30 rounded-xl p-8 backdrop-blur-sm scroll-mt-16 rigid-card system-card"
					>
						<div
							class="flex items-center justify-between border-b border-neutral-800/60 pb-3 mb-5 font-mono text-[10px] text-neutral-500"
						>
							<div class="flex items-center gap-1.5">
								<svg
									xmlns="http://www.w3.org/2000/svg"
									width="11"
									height="11"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2.5"
									stroke-linecap="round"
									stroke-linejoin="round"
									class="text-emerald-500"
									><polyline points="4 17 10 11 4 5"
									></polyline><line
										x1="12"
										y1="19"
										x2="20"
										y2="19"></line></svg
								>
								<span class="terminal-path">~/manifesto/core_philosophy.md</span>
							</div>
							<span>[STABLE]</span>
						</div>
						<span
							class="text-[10px] font-mono text-neutral-500 uppercase tracking-widest"
							>// Core Philosophy</span
						>
						<h1
							class="text-2xl font-bold mt-2 mb-4 tracking-tight text-neutral-100"
						>
							System Over Syntax
						</h1>
						<!-- De-textified Spec Grid -->
						<div class="font-mono text-xs space-y-4 border-t border-neutral-800/60 pt-4 mt-6">
							<div class="grid grid-cols-3 gap-2">
								<span class="text-neutral-500">[CONSTANTS]</span>
								<span class="col-span-2 text-neutral-200 font-semibold">Fundamental Architecture, Data Integrity</span>
							</div>
							<div class="grid grid-cols-3 gap-2">
								<span class="text-neutral-500">[VARIABLES]</span>
								<span class="col-span-2 text-neutral-400 italic">Framework Syntaxes, Language Trends</span>
							</div>
							<div class="grid grid-cols-3 gap-2 border-b border-neutral-800/40 pb-4">
								<span class="text-neutral-500">[CORE_VALUE]</span>
								<span class="col-span-2 text-neutral-300 leading-relaxed">
									Value isn't built on memorizing documentation that can be looked up in seconds. It is built on structural execution.
								</span>
							</div>

							<!-- Runtime Capabilities Checklist -->
							<div class="space-y-2.5 pt-2">
								<div class="text-neutral-500 font-bold uppercase text-[9px] tracking-wider">// OPERATIONAL_CAPABILITIES</div>
								<div class="flex items-start gap-2 text-neutral-400">
									<span class="text-amber-500">■</span>
									<span><strong class="text-neutral-200">Trace Data Flows:</strong> Explicit cross-stack pipeline mapping under high load.</span>
								</div>
								<div class="flex items-start gap-2 text-neutral-400">
									<span class="text-amber-500">■</span>
									<span><strong class="text-neutral-200">Isolate Failures:</strong> Rapid root-cause diagnosis of platform vectors under pressure.</span>
								</div>
								<div class="flex items-start gap-2 text-neutral-400">
									<span class="text-amber-500">■</span>
									<span><strong class="text-neutral-200">Environment Adaptability:</strong> Deciphering complex legacy technical codebases quickly.</span>
								</div>
							</div>
						</div>
					</section>

					<section
						id="capabilities"
						class="border border-neutral-800 bg-neutral-900/30 rounded-xl p-8 backdrop-blur-sm scroll-mt-16 rigid-card system-card"
					>
						<div
							class="flex items-center justify-between border-b border-neutral-800/60 pb-3 mb-5 font-mono text-[10px] text-neutral-500"
						>
							<div class="flex items-center gap-1.5">
								<svg
									xmlns="http://www.w3.org/2000/svg"
									width="11"
									height="11"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2.5"
									stroke-linecap="round"
									stroke-linejoin="round"
									class="text-blue-500/90"
									><rect
										width="20"
										height="16"
										x="2"
										y="4"
										rx="2"></rect><path d="M6 8h.01"
									></path><path d="M10 8h.01"></path><path
										d="M14 8h.01"></path></svg
								>
								<span class="terminal-path">~/workbench/operational_bounds.sys</span>
							</div>
							<span>[READY]</span>
						</div>
						<span
							class="text-[10px] font-mono text-neutral-500 uppercase tracking-widest"
							>// Operational Bounds</span
						>
						<h2
							class="text-xl font-bold mt-2 mb-4 tracking-tight text-neutral-200"
						>
							Cognitive Framework & Toolkit
						</h2>
						<div
							class="grid grid-cols-1 md:grid-cols-2 gap-6 text-sm"
						>
							<div
								class="border border-neutral-800/60 bg-neutral-950/40 rounded-lg p-4"
							>
								<h3
									class="font-semibold text-neutral-300 mb-2 font-mono text-xs uppercase tracking-wider text-neutral-400"
								>
									Implementation Stack
								</h3>
								<p
									class="text-neutral-400 leading-relaxed text-xs"
								>
									Vue.js interface orchestration, PHP Laravel
									backend pipelines, and system-agnostic
									structural programming logic.
								</p>
							</div>
							<div
								class="border border-neutral-800/60 bg-neutral-950/40 rounded-lg p-4"
							>
								<h3
									class="font-semibold text-neutral-300 mb-2 font-mono text-xs uppercase tracking-wider text-neutral-400"
								>
									Validation Guardrails
								</h3>
								<p
									class="text-neutral-400 leading-relaxed text-xs"
								>
									Playwright, Selenium, and Cypress automated
									testing suites alongside rigorous Postman
									API integration probing.
								</p>
							</div>
						</div>
					</section>

					<section
						id="projects"
						class="flex flex-col gap-4 scroll-mt-16"
					>
						<span
							class="text-[10px] font-mono text-neutral-500 uppercase tracking-widest"
							>// The Evidence</span
						>
						<h2
							class="text-xl font-bold tracking-tight mb-2 text-neutral-200"
						>
							Projects Area
						</h2>

						<!-- Capstone Project Card: Spatial E-Commerce Engine -->
						<div class="border border-neutral-800 bg-neutral-900/10 rounded-xl p-6 system-card project-card w-full">
							
							<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 border-b border-neutral-800/60 pb-4">
								<div class="flex items-center gap-3">
									<h3 class="text-sm font-bold tracking-tight text-neutral-300 font-mono">// SPATIAL_ECOMMERCE_ENGINE</h3>
									<div class="flex gap-1.5 font-mono text-[10px]">
										<span class="px-2 py-0.5 bg-neutral-800 text-neutral-400 border border-neutral-700 rounded">Vue.js</span>
										<span class="px-2 py-0.5 bg-neutral-800 text-neutral-400 border border-neutral-700 rounded">WebGL</span>
									</div>
								</div>
								
								<div class="flex gap-1 font-mono text-[10px]">
									<button 
										data-trigger="spec" 
										class="toggle-btn px-2 py-0.5 border border-neutral-200 bg-neutral-200 text-neutral-950 rounded transition-all duration-200 select-none cursor-pointer animate-fade-in"
									>
										--spec
									</button>
									<button 
										data-trigger="verbose" 
										class="toggle-btn px-2 py-0.5 border border-neutral-800 text-neutral-500 hover:text-neutral-300 hover:border-neutral-700 rounded transition-all duration-200 select-none cursor-pointer"
									>
										--verbose
									</button>
								</div>
							</div>

							<div class="grid grid-cols-1 lg:grid-cols-5 gap-8 items-stretch">
								
								<div class="lg:col-span-2 flex flex-col justify-between min-h-[320px]">
									
									<div data-panel="spec" class="space-y-4 text-xs leading-relaxed text-neutral-400 font-sans">
										<p>
											<slot name="objective">
												<strong class="text-neutral-200 block text-[13px] mb-1 font-mono">The Objective</strong> 
												Engineering an interactive platform designed to merge relational database commerce pipelines with responsive 3D asset manipulation and client-side web canvas spatial projections.
											</slot>
										</p>
										<p>
											<slot name="strategy">
												<strong class="text-neutral-200 block text-[13px] mb-1 font-mono">The Strategy</strong> 
												Isolated heavy graphic model parsing and object serialization overhead away from the main interface execution loop by deploying asynchronous asset streaming protocols.
											</slot>
										</p>
										<p>
											<slot name="execution">
												<strong class="text-neutral-200 block text-[13px] mb-1 font-mono">The Execution</strong> 
												Delivered a decoupled core system application layer that optimized browser paint cycles, maintaining a stable 60 FPS interactive render viewport during real-time client scaling transformations.
											</slot>
										</p>
									</div>

									<div data-panel="verbose" class="hidden font-mono text-[11px] leading-relaxed text-neutral-400 bg-neutral-950/40 border border-neutral-800/60 rounded p-4 space-y-3 h-full">
										<div class="text-neutral-500">// PIPELINE_COMPILATION_OUTPUT</div>
										<div>[STACK_INIT] ──► Vue.js Virtual Core Context Virtualization Map</div>
										<div>[GRAPHICS]   ──► WebGL_2.0 Canvas Element Canvas Binding Engine [PASS]</div>
										<div>[ASYNC_OPS]  ──► Blob Object Streaming Pipeline Allocation Optimization</div>
										<div>[DOM_REF]    ──► Dynamic Canvas Mutation Interceptor Matrix Active</div>
										<div class="text-neutral-500 mt-4">// RUNTIME_METRICS: Overhead throttled below 4.2ms compilation ceilings.</div>
									</div>
									
								</div>

								<div class="lg:col-span-3 border border-neutral-800/80 rounded-xl p-4 bg-neutral-950/40 font-mono text-[10px] text-neutral-400 flex flex-col justify-between min-h-[350px]">
									<div class="w-full flex flex-col h-full">
										<div class="flex items-center justify-between text-neutral-500 border-b border-neutral-800/60 pb-2 mb-2">
											<div class="flex items-center gap-2">
												<span>// GPU_RENDER_VIEWPORT</span>
												<button id="toggle-expand-btn" class="hidden text-[9px] border border-neutral-800 text-neutral-500 hover:text-neutral-200 hover:border-neutral-600 px-1.5 py-0.5 rounded cursor-pointer select-none font-mono transition-all">[ FULLSCREEN ]</button>
											</div>
											<span id="canvas-status" class="text-neutral-500 font-bold">○ OFFLINE</span>
										</div>

										<!-- Model Selector Segmented Control -->
										<div class="flex flex-wrap items-center gap-1 mb-3 font-mono text-[9px]" id="model-selector-container">
											<span class="text-neutral-500 mr-1">// MODEL:</span>
											<button data-model="HeartRing.glb" class="model-select-btn px-2 py-0.5 border border-neutral-200 bg-neutral-200 text-neutral-950 rounded select-none cursor-pointer">Heart Ring (301KB)</button>
											<button data-model="EvilEyeEarring.glb" class="model-select-btn px-2 py-0.5 border border-neutral-800 text-neutral-500 hover:text-neutral-300 hover:border-neutral-700 rounded select-none cursor-pointer">Evil Eye (307KB)</button>
											<button data-model="FlatBracelet.glb" class="model-select-btn px-2 py-0.5 border border-neutral-800 text-neutral-500 hover:text-neutral-300 hover:border-neutral-700 rounded select-none cursor-pointer">Bracelet (4.8MB)</button>
											<button data-model="HeartNecklace.glb" class="model-select-btn px-2 py-0.5 border border-neutral-800 text-neutral-500 hover:text-neutral-300 hover:border-neutral-700 rounded select-none cursor-pointer">Necklace (5.9MB)</button>
										</div>
										
										<div id="canvas-container" class="w-full h-[280px] relative overflow-hidden rounded border border-dashed border-neutral-800 bg-neutral-950/60 flex items-center justify-center shadow-inner transition-all duration-300 ease-in-out">
											<canvas id="jewelry-canvas" class="w-full h-full hidden"></canvas>
											
											<button 
												id="boot-canvas-btn" 
												class="absolute inset-0 w-full h-full flex flex-col items-center justify-center bg-neutral-900/80 hover:bg-neutral-800/50 transition-all duration-200 text-neutral-400 font-mono text-[10px] gap-1 z-10"
											>
												<span class="font-bold tracking-wider text-neutral-200">[ INITIALIZE GRAPHICS SUBSYSTEM ]</span>
												<span class="text-[9px] text-neutral-500 font-sans">Click to compile shader pipelines and mount 3D spatial matrix</span>
											</button>
										</div>
									</div>
									
									<div id="canvas-console-msg" class="text-neutral-500 italic mt-2 border-t border-neutral-800/40 pt-2">
										System idling. Awaiting graphics context initialization request...
									</div>
								</div>
								
							</div>
						</div>

						<details
							id="map-project-card"
							name="portfolio-projects"
							class="group border border-neutral-800 bg-neutral-900/10 rounded-xl overflow-hidden transition-all duration-300 open:bg-neutral-900/40 open:border-neutral-700 rigid-card system-card"
						>
							<summary
								class="flex justify-between items-center p-6 cursor-pointer list-none select-none hover:bg-neutral-900/30 transition-colors"
							>
								<div
									class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-4"
								>
									<h3
										class="font-bold text-neutral-300 tracking-tight group-open:text-neutral-100"
									>
										Unified Intake & Spatial Mapping Engine
									</h3>
									<div class="flex gap-1.5">
										<span
											class="inline-flex items-center gap-1.5 px-2 py-0.5 text-[10px] font-mono rounded bg-neutral-800 text-neutral-400 border border-neutral-700"
										>
											<svg
												xmlns="http://www.w3.org/2000/svg"
												width="11"
												height="11"
												viewBox="0 0 24 24"
												fill="none"
												stroke="currentColor"
												stroke-width="2.5"
												stroke-linecap="round"
												stroke-linejoin="round"
												class="text-amber-500/90"
												><path
													d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"
												></path><circle
													cx="12"
													cy="10"
													r="3"></circle></svg
											>
											Leaflet.js
										</span>
										<span
											class="inline-flex items-center gap-1.5 px-2 py-0.5 text-[10px] font-mono rounded bg-neutral-800 text-neutral-400 border border-neutral-700"
										>
											<svg
												xmlns="http://www.w3.org/2000/svg"
												width="11"
												height="11"
												viewBox="0 0 24 24"
												fill="none"
												stroke="currentColor"
												stroke-width="2.5"
												stroke-linecap="round"
												stroke-linejoin="round"
												class="text-blue-500/90"
												><rect
													width="18"
													height="18"
													x="3"
													y="3"
													rx="2"></rect><path
													d="M12 8v8"></path><path
													d="M8 12h8"></path></svg
											>
											Dynamic DOM Repeater
										</span>
										<span
											class="inline-flex items-center gap-1.5 px-2 py-0.5 text-[10px] font-mono rounded bg-neutral-800 text-neutral-400 border border-neutral-700"
										>
											<svg
												xmlns="http://www.w3.org/2000/svg"
												width="11"
												height="11"
												viewBox="0 0 24 24"
												fill="none"
